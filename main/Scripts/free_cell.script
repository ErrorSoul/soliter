local ui_fx = require("main.Scripts.ui_fx")

function init(self)
   self.is_occupied = false
   self.card = nil
   self.dragon_button_trace = nil
   self.slot_id = nil
   self.curson = nil
end

local function check_dragon(card)
   return card.data.value == 'd'
end

local function wo_array(arr, cond)
   local tbl = {}
   for key, value in pairs(arr) do
      if cond ~= key then
         table.insert(tbl, value)
      end

   end
   return tbl
end

function change_button_counter(self, num, wo)
   local without_arr = wo or self.dragon_button_trace
   for _, id in pairs(without_arr) do
      msg.post(id, 'change_free_slots_button_counter', {num = num})
   end
end

function send_to_dragon_buttons(self, card, num)
   if check_dragon(card) then
      local url = self.dragon_button_trace[card.data.suit]
      local wo_arr = wo_array(self.dragon_button_trace, card.data.suit)

      --msg.post(url, 'set_dragon_card_pos', {pos = go.get_position()})
      change_button_counter(self, num, wo_arr)
      -- отправить в другие кнопки дракона, что один из фри слотов занят другим цветом
   else
      change_button_counter(self, num)
   end
end

-- C4: зеркало содержимого ячейки в main.script — тот же приём, что дельта-зеркало
-- tableau (tableau_card_added/removed). Без него snapshot_and_go_map не знает, что
-- лежит в ячейках, и солвер решает не ту позицию. Шлём ФИНАЛЬНОЕ состояние
-- (card_data + is_blocked), а не дельту, — тогда все четыре случая occupy_slot
-- (пустая/занятая × blocked/нет) покрыты одним вызовом.
-- Порядок сообщений не важен. Единственный случай, когда в одну ячейку в одном
-- кадре приходят два сообщения, — сбор драконов на ячейку с уже припаркованным
-- драконом той же масти (card.script шлёт occupy_slot новому слоту и remove_card
-- прежнему владельцу, а это она же). Оба порядка сходятся к верному финалу:
-- occupy→remove — второе уходит в blocked-ветку и зеркала не шлёт; remove→occupy —
-- зеркало «пусто» тут же перекрывается зеркалом «стопка, blocked». Последнее
-- отправленное всегда верно, потому что шлём состояние, а не дельту.
local function mirror_to_main(self)
   if not self.slot_id then
      print("[FREE_CELL] mirror without slot_id — set_cursor не пришёл, снапшот будет неполным")
      return
   end
   msg.post("/card_table#main", "free_cell_changed", {
      slot_id = self.slot_id,
      card = self.card_data,               -- { id = <go>, data = {value, suit} } | nil
      is_blocked = self.is_blocked or false,
   })
end

function on_message(self, message_id, message, sender)
   if message_id == hash("check_slot") then
      if self.is_occupied then
         msg.post(sender, "slot_invalid")
      else
         msg.post(sender, "slot_valid")
      end
   elseif message_id == hash("set_cursor") then
      self.cursor = sender
      self.slot_id = message.slot_id
      self.dragon_button_trace = message.params

   elseif message_id == hash("occupy_slot") then

      self.current_card = sender
      message.slot_id = go.get_id()
      self.card_data = message.card
      --go.set_position(go.get_position(), sender)
      if message.animation then
         go.animate(message.card.id, "position", go.PLAYBACK_ONCE_FORWARD, go.get_position() + vmath.vector3(0, 0, 0.2), go.EASING_LINEAR, 0.5, 0.3)
      else
         go.set_position(message.position, message.card.id)
      end
      local dragon = check_dragon(message.card) and message.card.data.suit or nil
      if message.complete then
         if not self.is_blocked then
            self.is_blocked = true
            -- C11: уведомление курсора и изменение счётчиков разъехались, и это
            -- главное здесь. Уведомлять надо ВСЕГДА: когда стопка садится на
            -- ячейку с уже припаркованным драконом (`is_occupied` уже true),
            -- прежний гард глушил сообщение целиком, и у cursor в `free_slots`
            -- навсегда оставалась запись `{dragon=<масть>, is_blocked=false}` от
            -- момента парковки. `send_auto_finish_check` шлёт её в main, а
            -- `can_auto_finish` читает «в ячейке лежит несобранный дракон» и
            -- отказывает до конца партии — на доске, которую доигрывает.
            -- Счётчик кнопок при этом трогаем только для свободной ячейки: занятая
            -- свой −1 уже вычла при парковке (ради этого гард и ставился, F2).
            msg.post(self.cursor, "update_free_slot", {slot_id = self.slot_id, dragon = dragon, is_empty = false, is_blocked = true})
            if not self.is_occupied then
               send_to_dragon_buttons(self, message.card, -1)
            end
         end
      else
         msg.post(self.cursor, "update_free_slot", {slot_id = self.slot_id, dragon = dragon, is_empty = false})
         send_to_dragon_buttons(self, message.card, -1)
      end
      self.is_occupied = true
      mirror_to_main(self)
   elseif message_id == hash("clear_slot") then
      self.is_occupied = false
      self.current_card = nil
   elseif message_id == hash("remove_card") then
      if not self.is_blocked then
         self.is_occupied = false
         send_to_dragon_buttons(self, self.card_data, 1)
         msg.post(self.cursor, "update_free_slot", {slot_id = self.slot_id, dragon = nil, is_empty = true })
         self.current_card = nil
         self.card_data = nil
         mirror_to_main(self)
      end
      -- C10: заблокированная ячейка НИЧЕГО не возвращает. Раньше здесь стояло
      -- `change_button_counter(self, 1)` с комментарием «for other-suit buttons
      -- only» — комментарий врал (`wo` не передан ⇒ шло всем трём), а сам +1 был
      -- ничем не обеспечен: ячейка со стопкой драконов ушла навсегда.
      -- Единственный путь, на котором сюда вообще приходит `remove_card`, — карта,
      -- чей `self.owner` уже эта ячейка (`card.script:109`), получила новый
      -- `drop_success` в неё же: сбор драконов на ячейку с ранее припаркованным
      -- драконом той же масти (её `cursor.get_dragon_cards` как раз предпочитает).
      -- Взять карту из заблокированной ячейки нельзя (`can_pick_card` отказывает),
      -- `clear_slot` не шлёт никто, `is_blocked` не сбрасывается нигде — так что
      -- потерянного «законного» +1 не существует. Замерено на настоящем скрипте:
      -- было red=4 blue=3 green=3 при двух реально свободных ячейках, стало
      -- red=3 blue=2 green=2 — как на порядке «сбор в пустую ячейку».

   elseif message_id == hash("can_pick_card") then
      if self.is_occupied and not self.is_blocked then
        msg.post(sender, "slot_with_card", self.card_data) --id = self.current_card})
      else
      end
   elseif message_id == hash("highlight") then
      ui_fx.highlight(1.06)
   elseif message_id == hash("unhighlight") then
      ui_fx.unhighlight()
   end
end

function update(self, dt)
end
