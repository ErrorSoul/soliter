local tutorial_state = require("main.Scripts.tutorial_state")
local config = require("main.Scripts.config")

function init(self)
    self.is_empty = false
    self.pending_top_check = false
end

-- A6: last_card_to_slot откладываем (обычно на 1 кадр — Defold флашит сообщения
-- ПОСЛЕ фазы update, а порядок update() между GO не гарантирован). Ключ не в
-- «одном кадре», а в КОАЛЕСИНГЕ: при переносе стопки move_stack_cards постит все
-- drop_success синхронно → все remove_card попадают в один флаш очереди пачкой.
-- Раньше last_card_to_slot звался на КАЖДЫЙ remove_card, и промежуточная верхушка
-- (карта, которая сама в переносе) угонялась вторым drop_success в base slot.
-- Теперь ставим флаг, а решение принимаем один раз в update() — по осевшей после
-- всей пачки верхушке. Флаг сбрасывается до вызова → двойной отправки нет.
function update(self)
    if self.pending_top_check then
        self.pending_top_check = false
        last_card_to_slot(self)
    end
end
local function remove_by_id(tbl, target_id)
   for i, item in ipairs(tbl) do
      if item.id == target_id then
         table.remove(tbl, i) -- Удаляем элемент по индексу
         return true -- Успешно удалено
      end
   end
   return false -- Элемент не найден
end

local function reverse_table(tbl)
    local reversed = {}
    for i = #tbl, 1, -1 do
        table.insert(reversed, tbl[i])
    end
    return reversed
end
local function color_to_cell(card)
   return config.DRAGON_BUTTON_TRACE[card.data.suit]
end
function last_card_to_slot(self)
   local card = reverse_table(self.stack)[1]
   if card then
      -- H6: УХОДИТ ли карта — решает config.auto_flies_from_tableau, тот же
      -- предикат, по которому hit_test запрещает за неё браться. Здесь остаётся
      -- только «куда». Условие нарочно не продублировано: разъехавшись, эти два
      -- места дали бы окно, где карта уже неприкасаемая, но никуда не летит.
      if config.auto_flies_from_tableau(card.data, tutorial_state.is_tutorial) then
         if card.data.value == 'f' then
            msg.post(self.cursor, 'send_to_flower_slot', card)
         else
            msg.post(self.cursor, 'send_to_base_slot', card)
         end
      elseif card.data.value == 'd' then
         msg.post(color_to_cell(card), 'send_counter_to_button', card)
      end
   end
end

function on_message(self, message_id, message, sender)
   if message_id == hash("update_stack") then
      self.stack = message.stack
      self.index = message.index
      self.cursor = message.cursor
      self.is_empty = (#self.stack == 0)
      self.pending_top_check = true  -- A6: авто-отправку решаем в update, после осадки кадра
      update_visible_cards(self)
   elseif message_id == hash("remove_card") then
      if remove_by_id(self.stack, message.id) then
         if #self.stack == 0 then
            self.is_empty = true
         end
         -- B: дельта-зеркало для main.tableau_stacks (auto-finish/snapshot)
         msg.post("/card_table#main", "tableau_card_removed", { index = self.index, id = message.id })
      end
      self.pending_top_check = true  -- A6: авто-отправку решаем в update, после осадки кадра
      update_visible_cards(self)
   elseif message_id == hash("occupy_slot") then
      message.card.slot_id = go.get_id()
      table.insert(self.stack, message.card)
      self.is_empty = false  -- A4: слот перестал быть пустым
      -- B: дельта-зеркало для main.tableau_stacks (auto-finish/snapshot)
      msg.post("/card_table#main", "tableau_card_added", {
         index = self.index,
         card = { id = message.card.id, data = message.card.data, slot_id = go.get_id() }
      })
      self.pending_top_check = true  -- A6: 2/flower/dragon just placed must auto-send
      update_visible_cards(self)
   elseif message_id == hash("check_slot") then
      if self.is_empty then
         msg.post(sender, "slot_valid")
      else
         msg.post(sender, "slot_invalid")
      end
   end
end

function update_visible_cards(self)
   local visible_cards = {}
   -- Проходим по стопке карт снизу вверх (от 1 до #self.stack)
   for i = #self.stack, 1, -1 do
      local current_card = self.stack[i]
      if #visible_cards == 0 then
         table.insert(visible_cards, current_card)
      elseif can_stack_cards(visible_cards[#visible_cards], current_card) then
         table.insert(visible_cards, current_card)
      else
         break
      end
   end

   -- Обновляем состояние всех карт в стопке.
   -- G5: шаг зависит от ДЛИНЫ колонки — длинная сжимается, чтобы влезть в экран
   -- (config.stack_offset_y). Это единственное авторитетное место раскладки:
   -- сюда приходит и раздача, и дроп, и перенос стопки, и всё пересчитывается
   -- целиком. Поэтому промежуточные цели анимаций (например -40 в cursor)
   -- допустимы: кадром позже карты садятся ровно сюда.
   local slot_y = go.get_position().y
   local pitch = config.stack_offset_y(#self.stack, slot_y)
   for i, card in ipairs(self.stack) do
      local z_index = (i == #self.stack) and config.Z_CARD_LAST_IN_STACK or config.Z_CARD_STACK_BASE + i * config.Z_CARD_STACK_STEP
      local y = slot_y + (i-1) * pitch
      go.set_position(vmath.vector3(go.get_position().x, y, z_index), card.id)
   end

   -- Сохраняем список видимых карт
   self.visible_cards = visible_cards
   msg.post(self.cursor, "set_stack", { index = self.index, stack = reverse_table(self.visible_cards) })

   msg.post(self.cursor, "set_last_cards", { index = self.index, card = reverse_table(self.stack)[1] })
end

-- Функция для проверки, можно ли сложить карты в стопку
function can_stack_cards(bottom_card, top_card)
   if not bottom_card or not top_card then
      return false
   end
   -- Карты-драконы и цветы не могут участвовать в последовательности
   if bottom_card.data.is_flower or bottom_card.data.is_dragon or
      top_card.data.is_flower or top_card.data.is_dragon then
      return false
   end
   return bottom_card.data.suit ~= top_card.data.suit and bottom_card.data.value == top_card.data.value - 1
end
-- Вспомогательная функция для проверки наличия карты в массиве
function contains(arr, item)
   for _, v in ipairs(arr) do
      if v == item then
         return true
      end
   end
   return false
end
