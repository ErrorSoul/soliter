-- cursor.script
-- go.property("selected_card", nil)
local DEBUG_SOLVER = true -- press 'S' to let the solver play the current deal (dev tool)
local tutorial_state = require("main.Scripts.tutorial_state")
local config = require("main.Scripts.config")
local coords = require("main.Scripts.coords")
local hit = require("main.Scripts.hit_test")

local function get_slot_target_type(slot_id)
   if string.sub(slot_id, 1, 9) == "base_slot" then return "base"
   elseif string.sub(slot_id, 1, 9) == "free_slot" then return "free"
   elseif string.sub(slot_id, 1, 12) == "tableau_slot" then return "tableau_empty"
   elseif slot_id == "flower_slot" then return "flower"
   end
   return "unknown"
end

function init(self)
   -- Отключаем лишние сообщения о коллизиях
   self.is_processing = false
   self.valid = false
   -- Получаем размеры окна при старте
   self.tableau_stacks = {}
   self.last_cards = {}
   self.was_pressed = false
   self.dragging_stack = false
   self.prev_cursor_x = 0
   self.stack_offset = {}  -- Сохраняем смещение каждой карты относительно первой
   self.input_disabled = false
   self.flying_count = 0  -- A3: сколько карт сейчас в авто-полёте (дуга)
   self.tutorial_highlights_applied = false
   msg.post(".", "acquire_input_focus")
   -- Draw colored text on the screen
end

function on_input(self, action_id, action)
   if self.input_disabled then return end
   -- Только позиционные действия (мышь/тач) несут координаты; клавиши (solve/replay/space)
   -- приходят с action.x == nil — для них курсор не двигаем.
   if action.x then
      local worldx, worldy = coords.screen_to_world(action.x, action.y)
      self.cursor_pos = vmath.vector3(worldx, worldy, 0)
      go.set_position(self.cursor_pos, ".")
   end

   if action_id == hash("space") then

      if action.pressed then
         msg.post("@system:", "toggle_physics_debug") -- <3>
         msg.post("/card_table#main", "init") -- <3>
      else
         msg.post("@system:", "toggle_physics_debug") -- <3>
      end
   end

   if DEBUG_SOLVER and action_id == hash("solve") and action.pressed then
      msg.post("/card_table#main", "debug_solve")
   end
   if DEBUG_SOLVER and action_id == hash("replay") and action.pressed then
      msg.post("/card_table#main", "debug_replay")
   end
   if action_id == hash("touch") then
      if action.pressed then
         -- A3: пока карты в авто-полёте (цветок/драконы) — игнорируем нажатия,
         -- иначе можно схватить летящую карту и отменить её дугу.
         if self.flying_count and self.flying_count > 0 then
            return
         end
         -- A2: HTML5 теряет mouseup при уходе курсора с канваса, touch-cancel на
         -- мобиле. Если приходит новый press, а прошлый drag так и не получил
         -- release — возвращаем зависшие карты на место и чистим состояние,
         -- затем продолжаем обработку нового нажатия (fall-through).
         if self.is_dragging then
            if self.dragging_stack and self.stack_cards then
               for _, card in ipairs(self.stack_cards) do
                  msg.post(card.id, "drop_failed", {
                     position = self.original_position + card.relative_pos
                  })
               end
            elseif self.selected_card then
               msg.post(self.selected_card, 'drop_failed', {position = self.original_position})
            end
            clean_cursor(self)
         end
         self.was_pressed = true
         local btn_color = hit.check_dragon_buttons(self, action.x, action.y)

         if btn_color then
            self.pending_drop = btn_color
            msg.post(btn_color.slot_id, 'get_dragon_cards')
            return
         end

         local card = hit.check_tableau_slots(self, action.x, action.y)
         if card then
            self.selected_card = card.id
            self.selected_card_data = card.source
            self.is_dragging = true
            self.dragging_stack = card.is_stack
            self.is_single_card = card.is_single

            if card.is_stack then
               self.stack_cards = card.stack
            end

            self.original_position = card.pos
            self.drag_offset = self.original_position - self.cursor_pos

            if self.dragging_stack then
               -- Начинаем тащить стопку
               for _, stack_card in ipairs(self.stack_cards) do
                   msg.post(stack_card.id, "start_drag")
               end
            else
               -- Тащим одну карту
               msg.post(self.selected_card, "start_drag")
            end
            return
         end

         local free_slot = hit.check_free_slots(self, action.x, action.y)

         if free_slot then
            self.pending_drop = free_slot
            msg.post(free_slot.slot_id, "can_pick_card")
            return
         end



      elseif action.released then
         self.was_pressed = false

         if self.is_dragging then
            -- Проверяем различные слоты

            -- Если тащим стопку, разрешаем дроп только в tableau слоты
            if self.dragging_stack then
               local tableau_slot = hit.check_free_tableau_slots(self, action.x, action.y)
               if tableau_slot then
                  self.pending_drop = {slot = tableau_slot}
                  msg.post(tableau_slot.slot_id, "check_slot", {
                              cards = self.stack_cards,
                              source_card = self.selected_card_data
                  })
                  return
               end

               local card = hit.check_last_cards(self, action.x, action.y)
               if card then

                  self.pending_drop = {card = card, slot_id = card.slot_id}
                  msg.post(card.id, "can_move_card", {card = self.selected_card_data})
                  return
               end

               -- Возвращаем стопку на место при попытке дропа в неразрешенный слот
               for _, card in ipairs(self.stack_cards) do
                  msg.post(card.id, "drop_failed", {
                              position = self.original_position + card.relative_pos
                  })
               end
               -- Возвращаем карту на место если никуда не попали
               --msg.post(self.selected_card, 'drop_failed', {position = self.original_position})

               clean_cursor(self)
               return
            end

            local card = hit.check_last_cards(self, action.x, action.y)
            if card then

               self.pending_drop = {card = card, slot_id = card.slot_id}
               msg.post(card.id, "can_move_card", {card = self.selected_card_data})
               return
            end

            local free_slot = hit.check_free_slots(self, action.x, action.y)
            -- Обработка перемещения одиночной карты
            if free_slot then
               self.pending_drop = {slot = free_slot}
               msg.post(free_slot.slot_id, 'check_slot')
               return
            end

            local flower_slot = hit.check_flower_slot(self, action.x, action.y)
            if flower_slot then
               self.pending_drop = {slot = flower_slot}
               msg.post(flower_slot.slot_id, "check_slot", {card = self.selected_card_data})
               return
            end

            local base_slot = hit.check_base_slots(self, action.x, action.y)
            if base_slot then
               self.pending_drop = {slot = base_slot}
               msg.post(base_slot.slot_id, 'check_slot', {card = self.selected_card_data})
               return
            end

            local tableau_slot = hit.check_free_tableau_slots(self, action.x, action.y)
            if tableau_slot then
               self.pending_drop = {slot = tableau_slot}
               msg.post(tableau_slot.slot_id, 'check_slot', {card = self.selected_card_data})
               return
            end

          -- Возвращаем карту на место если никуда не попали
         msg.post(self.selected_card, 'drop_failed', {position = self.original_position})
         clean_cursor(self)

         end
      end

      -- Обновление позиций при перетаскивании
      if self.is_dragging then
         local offset = self.drag_offset or vmath.vector3(0, 0, 0)
         local dx = self.cursor_pos.x - self.prev_cursor_x
         -- Tilt: scale.x уменьшается при горизонтальном движении (эффект 3D поворота)
         local tilt = 1.0 - math.min(math.abs(dx) * 0.04, 0.45)
         if self.dragging_stack then
            for _, card in ipairs(self.stack_cards) do
               msg.post(card.id, "drag_update", {
                   position = self.cursor_pos + offset + card.relative_pos,
                   tilt = tilt
               })
            end
         else
            msg.post(self.selected_card, "drag_update", {position = self.cursor_pos + offset, tilt = tilt})
         end
      end
      self.prev_cursor_x = self.cursor_pos.x


   end
end

function move_stack_cards(self, message_id, params)
   for _, card in ipairs(self.stack_cards) do
       msg.post(card.id, message_id, {
                  card = card.source,
                  slot_id = params.slot_id,
                  position = card.relative_pos + params.position
      })
   end
end

local function set_cursor(slots, params)
   local p = params or {}
   for slot_id, _ in pairs(slots) do
      msg.post(slot_id, "set_cursor", {slot_id = slot_id, params=p})
   end
end

-- Tutorial highlight: find card GO by data id (e.g. "2_red")
local function find_card_by_data_id(self, data_id)
    -- Search visible stacks (pairs — stacks may have gaps)
    for _, stack in pairs(self.tableau_stacks) do
        for _, card in ipairs(stack) do
            if card.data and card.data.id == data_id then
                return card.id
            end
        end
    end
    -- Search last cards (top of each stack)
    for _, card in pairs(self.last_cards) do
        if card and card.data and card.data.id == data_id then
            return card.id
        end
    end
    return nil
end

local function clear_tutorial_highlights(self)
    -- Unhighlight all cards in all stacks (pairs — stacks may have gaps)
    for _, stack in pairs(self.tableau_stacks) do
        for _, card in ipairs(stack) do
            msg.post(card.id, "unhighlight")
        end
    end
    -- Unhighlight last cards (top of each stack)
    for _, card in pairs(self.last_cards) do
        if card then
            msg.post(card.id, "unhighlight")
        end
    end
    -- Unhighlight slots
    for slot_id, _ in pairs(self.base_slots) do
        msg.post(slot_id, "unhighlight")
    end
    for slot_id, _ in pairs(self.free_slots) do
        msg.post(slot_id, "unhighlight")
    end
    for btn_id, _ in pairs(self.dragon_buttons) do
        msg.post(btn_id, "unhighlight")
    end
end

local function apply_tutorial_highlights(self)
    local highlights = tutorial_state.HIGHLIGHTS[tutorial_state.step]
    if not highlights then return end

    -- Highlight cards
    for _, card_data_id in ipairs(highlights.cards) do
        local card_go = find_card_by_data_id(self, card_data_id)
        if card_go then
            msg.post(card_go, "highlight")
        end
    end

    -- Highlight slots
    for _, slot_id in ipairs(highlights.slots) do
        msg.post(slot_id, "highlight")
    end

    -- Dynamic: highlight the base slot that already has a card (e.g. where 2_red landed)
    if highlights.find_occupied_base then
        for slot_id, slot in pairs(self.base_slots) do
            if not slot.is_empty then
                msg.post(slot_id, "highlight")
            end
        end
    end
end

local function fly_card_arc(card_id, target_pos, delay, callback)
    local start_pos = go.get_position(card_id)
    local fly_z = 0.5
    local mid = vmath.vector3(
        (start_pos.x + target_pos.x) / 2,
        math.max(start_pos.y, target_pos.y) + 80,
        fly_z
    )
    local land = vmath.vector3(target_pos.x, target_pos.y, fly_z)
    go.animate(card_id, "position", go.PLAYBACK_ONCE_FORWARD,
        mid, go.EASING_OUTQUAD, 0.35, delay, function()
            go.animate(card_id, "position", go.PLAYBACK_ONCE_FORWARD,
                land, go.EASING_INQUAD, 0.35, 0, callback)
        end)
end

function on_message(self, message_id, message, sender)
   if message_id == hash("set_free_slots") then
      self.free_slots = message
      set_cursor(self.free_slots, config.DRAGON_BUTTON_TRACE)
   elseif message_id == hash("set_flower_slot") then
      self.flower_slot = message
   elseif message_id == hash("set_base_slots") then
      self.base_slots = message
      set_cursor(self.base_slots)

   elseif message_id == hash("set_tableau_slots") then
      self.tableau_slots = message
   elseif message_id == hash("set_dragon_buttons") then
      self.dragon_buttons = message
   elseif message_id == hash("set_cards") then
      self.cards = message
   elseif message_id == hash("set_stack") then
      self.tableau_stacks[message.index] = message.stack
      local empty_flag = (#message.stack == 0)
      self.tableau_slots['tableau_slot'..message.index].is_empty = empty_flag
      -- Trigger initial tutorial highlights once main stack (1) is loaded
      if tutorial_state.is_tutorial and message.index == 1 and not self.tutorial_highlights_applied then
         self.tutorial_highlights_applied = true
         tutorial_state.highlight_dirty = true
      end

   elseif message_id == hash("set_last_cards") then
      self.last_cards[message.index] = message.card
   elseif message_id == hash("slot_valid") and self.pending_drop then
      local params = {
         slot_id =  self.pending_drop.slot.slot_id,
         position = self.pending_drop.slot.slot_pos,
         card = self.selected_card_data
      }

      if self.dragging_stack then
         move_stack_cards(self, 'drop_success', params)
      else
         msg.post(self.selected_card, 'drop_success', params)
      end

      -- Tutorial: advance only when the move matches expected (no blocking)
      if tutorial_state.is_tutorial and self.selected_card_data then
         local card_id = self.selected_card_data.data.id
         local target_type = get_slot_target_type(self.pending_drop.slot.slot_id)
         if tutorial_state.check_move(card_id, target_type) then
            tutorial_state.advance()  -- sets ui_dirty flag, UI polls it
         end
      end

      clean_cursor(self)
      if not tutorial_state.is_tutorial then
         local free_cell_cards = {}
         for slot_id, slot in pairs(self.free_slots) do
            if not slot.is_empty then
               table.insert(free_cell_cards, { slot_id = slot_id, dragon = slot.dragon, is_blocked = slot.is_blocked })
            end
         end
         msg.post("/card_table#main", "check_auto_finish", { free_cells = free_cell_cards })
      end
   elseif message_id == hash("slot_invalid") and self.pending_drop then
      -- A5: при переносе стопки возвращаем ВСЕ карты, а не только нижнюю.
      if self.dragging_stack and self.stack_cards then
         for _, card in ipairs(self.stack_cards) do
            msg.post(card.id, "drop_failed", {
               position = self.original_position + card.relative_pos
            })
         end
      else
         msg.post(self.selected_card, 'drop_failed', {position = self.original_position})
      end
      clean_cursor(self)
   elseif message_id == hash("invalid_card")  then
      if self.is_dragging then
         if self.dragging_stack then
            for _, card in ipairs(self.stack_cards) do
               msg.post(card.id, "drop_failed", {
                   position = self.original_position + card.relative_pos
               })
            end
         else
            msg.post(self.selected_card, 'drop_failed', {position = self.original_position})
         end
      end

      clean_cursor(self)
   elseif message_id == hash("valid_card") and self.pending_drop then
      local params = {
         position = (self.pending_drop.card.pos + vmath.vector3(0, -40, 0)),
         slot_id = self.pending_drop.slot_id,
         card = self.selected_card_data
      }

      if self.dragging_stack then
         move_stack_cards(self, 'drop_success', params)
      else
         msg.post(self.selected_card, 'drop_success', params)
      end

      -- Tutorial: advance only when the move matches expected (no blocking)
      if tutorial_state.is_tutorial and self.selected_card_data then
         local card_id = self.selected_card_data.data.id
         local target_card_id = self.pending_drop.card.data_id
         if tutorial_state.check_move(card_id, "tableau_card", target_card_id) then
            tutorial_state.advance()  -- sets ui_dirty flag, UI polls it
         end
      end

      clean_cursor(self)
      if not tutorial_state.is_tutorial then
         local free_cell_cards = {}
         for slot_id, slot in pairs(self.free_slots) do
            if not slot.is_empty then
               table.insert(free_cell_cards, { slot_id = slot_id, dragon = slot.dragon, is_blocked = slot.is_blocked })
            end
         end
         msg.post("/card_table#main", "check_auto_finish", { free_cells = free_cell_cards })
      end
   elseif message_id == hash("slot_with_card") and self.pending_drop then
      self.selected_card = message.id
      self.selected_card_data = message
      self.is_dragging = true
      self.original_position = self.pending_drop.slot_pos
      self.drag_offset = vmath.vector3(0, 0, 0)
      msg.post(self.selected_card, "start_drag")
   elseif message_id == hash("send_to_flower_slot") then
      local fl_pos = self.flower_slot['flower_slot']
      local captured = message
      self.flying_count = self.flying_count + 1  -- A3
      fly_card_arc(captured.id, fl_pos, 0, function()
         self.flying_count = self.flying_count - 1  -- A3
         msg.post(captured.id, 'drop_success', {
                     slot_id = 'flower_slot',
                     position = fl_pos,
                     card = captured,
                     animation = true,
                     complete = true
         })
      end)
   elseif message_id == hash("base_slot_full") then
      self.base_slots[message.slot_id].is_empty = false
   elseif message_id == hash("send_to_base_slot") then
      local slot = config.BASE_SLOT_TRACE[message.data.suit]
      local is_empty = self.base_slots[slot].is_empty
      if not is_empty then
         for slot_id, sl in pairs(self.base_slots) do
            if sl.is_empty then
               slot = slot_id
               break
            end
         end
      end

      msg.post(message.id, 'drop_success', {
                  slot_id = slot,
                  position = self.base_slots[slot].pos,
                  card = message,
                  animation = true
      })
   elseif message_id == hash("disable_input") then
      self.input_disabled = true
   elseif message_id == hash("enable_input") then
      self.input_disabled = false
   elseif message_id == hash("update_free_slot") then
      self.free_slots[message.slot_id].is_empty = message.is_empty
      self.free_slots[message.slot_id].dragon = message.dragon
      self.free_slots[message.slot_id].is_blocked = message.is_blocked or false
   elseif message_id == hash("send_auto_finish_check") then
      local free_cell_cards = {}
      for slot_id, slot in pairs(self.free_slots) do
         if not slot.is_empty then
            table.insert(free_cell_cards, { slot_id = slot_id, dragon = slot.dragon, is_blocked = slot.is_blocked })
         end
      end
      msg.post("/card_table#main", "check_auto_finish", { free_cells = free_cell_cards })
   elseif message_id == hash("set_button_state") then
      self.dragon_buttons[message.slot_id].is_active = message.is_active
   elseif message_id == hash("get_dragon_cards") and self.pending_drop then
      local sl_id, sl_pos
      local color = self.pending_drop.color
      -- Сначала ищем слот с драконом нужного цвета
      for slot_id, value in pairs(self.free_slots) do
         if value.dragon == color then
            sl_id = slot_id
            sl_pos = value.pos
            break
         end
      end
      -- Если дракона нет в free cells — берём пустой слот
      if not sl_id then
         for slot_id, value in pairs(self.free_slots) do
            if value.is_empty then
               sl_id = slot_id
               sl_pos = value.pos
               break
            end
         end
      end

      local i = 0
      for _, card in pairs(message) do
         local arc_delay = i * 0.1
         local captured_card = card
         self.flying_count = self.flying_count + 1  -- A3
         fly_card_arc(captured_card.id, sl_pos, arc_delay, function()
            self.flying_count = self.flying_count - 1  -- A3
            msg.post(captured_card.id, 'drop_success', {
               slot_id = sl_id,
               position = sl_pos,
               card = captured_card,
               animation = false,
               complete = true
            })
         end)
         i = i + 1
      end


   end
end

function clean_cursor(self)
   self.selected_card = nil
   self.selected_card_data = nil
   self.is_dragging = false
   self.dragging_stack = false
   self.is_single_card = false
   self.stack_cards = nil
   self.current_slot = nil
   self.pending_drop = nil
   self.drag_offset = vmath.vector3(0, 0, 0)
end

function update(self, dt)
   -- Tutorial highlights polling
   if tutorial_state.is_tutorial and tutorial_state.highlight_dirty then
      tutorial_state.highlight_dirty = false
      clear_tutorial_highlights(self)
      apply_tutorial_highlights(self)
   end

end
