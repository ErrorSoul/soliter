function init(self)
   self.empty = true
end

function on_message(self, message_id, message, sender)
   if message_id == hash("check_slot") then
      if self.empty and message.card.data.value ~= 'f' then
         msg.post(sender, "slot_invalid")
      elseif self.empty and message.card.data.value == 'f' then
         msg.post(sender, "slot_valid")
      else
         msg.post(sender, "slot_invalid")
      end
   elseif message_id == hash("occupy_slot") then
      self.empty = false
      -- C5: зеркало в main. Цветок уходит из tableau_stacks по remove_card, и без
      -- этого сообщения снапшот забывает его насовсем: snap.flower ставился только
      -- пока цветок ЛЕЖИТ на верхушке столбца (окно полёта ~0.7 c).
      msg.post("/card_table#main", "flower_collected")
      -- cursor owns the complete arc. A second flight here kept the flower
      -- above the board after input had already been released.
      go.set_position(message.position, message.card.id)
   end
end
