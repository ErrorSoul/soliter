function deal_tutorial_cards(self)
   local tableau_positions = get_tableau_positions(self)
   self.tableau_stacks = {}

   -- 10 карт, 5 стеков. БЕЗВАРИАТИВНАЯ раскладка.
   -- Все нумерованные карты в S1 друг под другом — открываются последовательно.
   -- При каждом шаге видна ОДНА возможная комбинация.
   -- Step 0: 2_red → foundation (2→5 не консек.)
   -- Step 1: 3_red → foundation (3→5 не консек.)
   -- Step 2: 7_green → free cell (7→found нет 6g, 7→5g same color)
   -- Step 3: 4_blue → на 5_green (стекинг! 4→5, blue≠green)
   -- Step 4: dragon button → все 4 d_red видны → собрать
   -- flower авто-улетает → Victory!
   local layout = {
      {1, {
         {id="d_red", value="d", suit="red", is_dragon=true},
         {id="4_blue", value=4, suit="blue"},
         {id="7_green", value=7, suit="green"},
         {id="3_red", value=3, suit="red"},
         {id="2_red", value=2, suit="red"},
      }},
      {2, {
         {id="5_green", value=5, suit="green"},
      }},
      {3, {
         {id="d_red", value="d", suit="red", is_dragon=true},
      }},
      {4, {
         {id="d_red", value="d", suit="red", is_dragon=true},
      }},
      {5, {
         {id="d_red", value="d", suit="red", is_dragon=true},
         {id="flower", value="f", suit="flower", is_flower=true},
      }},
   }

   -- Инициализируем все 8 стеков
   for i = 1, 8 do
      local slot_id = "tableau_slot" .. i
      self.tableau_stacks[i] = { slot_id = slot_id, cards = {}, animations_completed = 0 }
   end

   -- Размещаем карты по layout
   for _, stack_def in ipairs(layout) do
      local stack_index = stack_def[1]
      local cards = stack_def[2]
      local stack_position = tableau_positions[stack_index]
      local slot_id = "tableau_slot" .. stack_index
      local cards_in_stack = #cards

      for card_index, card_data in ipairs(cards) do
         local card_offset = vmath.vector3(0, (card_index - 1) * config.stack_offset_y(cards_in_stack, stack_position.y), 0)
         local target_position = stack_position + card_offset

         local start_pos = vmath.vector3(480, 270, 0.2)
         local card = factory.create("#card_factory", start_pos, vmath.quat(0, 0, 0, 1))
         msg.post(card, "set_card", { data = card_data, slot_id = slot_id })

         table.insert(self.tableau_stacks[stack_index].cards, { id = card, data = card_data, slot_id = slot_id })
         table.insert(self.cards, card)

         local delay = 0.04 * (stack_index + card_index)
         go.set(card, "scale", vmath.vector3(0.5, 0.5, 1))
         go.animate(card, "scale", go.PLAYBACK_ONCE_FORWARD,
             vmath.vector3(1, 1, 1), go.EASING_OUTQUAD, 0.25, delay)
         go.animate(card, "position", go.PLAYBACK_ONCE_FORWARD, target_position, go.EASING_OUTQUAD, 0.25, delay, function()
            self.tableau_stacks[stack_index].animations_completed = self.tableau_stacks[stack_index].animations_completed + 1
            if self.tableau_stacks[stack_index].animations_completed == cards_in_stack then
               msg.post(slot_id, "update_stack", { cursor = self.cursor, index = stack_index, stack = self.tableau_stacks[stack_index].cards })
            end
         end)
      end
   end

   -- Сразу отправляем update_stack для пустых стеков (7, 8)
   for i = 1, 8 do
      if #self.tableau_stacks[i].cards == 0 then
         msg.post("tableau_slot" .. i, "update_stack", { cursor = self.cursor, index = i, stack = {} })
      end
   end
end

-- Перемешивание колоды
function shuffle_deck(self)
   -- D4: ЗДЕСЬ НЕ СИДИРУЕМ. os.time() отдаёт целые секунды, а тасовка зовётся
   -- на каждую раздачу — два рестарта в одну секунду брали один и тот же seed
   -- и давали побайтово одинаковую колоду. Генератор сидируется один раз, в
   -- game_manager.init: он живёт ВНЕ level proxy и, в отличие от этого скрипта,
   -- не умирает на рестарте. Состояние math.random общее на всю Lua-машину,
   -- поэтому выгрузка уровня его не трогает — замерено сценарием dealrng.
   -- 3 прохода Fisher-Yates для лучшего перемешивания
   for pass = 1, 3 do
      for i = #self.deck, 2, -1 do
         local j = math.random(1, i)
         self.deck[i], self.deck[j] = self.deck[j], self.deck[i]
      end
   end

   if DEBUG_DEAL then
      local blue_dragons = {}
      local rest = {}
      for _, card in ipairs(self.deck) do
         if card.is_dragon and card.suit == "blue" then
            table.insert(blue_dragons, card)
         else
            table.insert(rest, card)
         end
      end
      self.deck = rest
      self.debug_blue_dragons = blue_dragons
   end
end

function on_input(self, action_id, action)
end

function get_data(self)
   return {
      tableau_slots = self.tableau_stacks,
      free_slots = self.free_slots,
      cards = self.cards,
   }
end

-- C4: ячейки адресуются строковым slot_id ("free_slot1"..3, cursor.get_free_slots),
-- а солвер/replay — порядковым номером 1..3. Отображение живёт здесь, чтобы
-- free_cell.script не парсил цифру из своего id.
local FREE_CELL_ORD = { free_slot1 = 1, free_slot2 = 2, free_slot3 = 3 }

-- C5: перепись карт снапшота — единственный инвариант, который ловит ПОТЕРЮ карты.
-- Всё, что выводится из самого снапшота, потерю не видит: доска без 10_green
-- внутренне непротиворечива, солвер честно доводит её до конца и рапортует
-- "SOLVED", а партия встаёт на R10 B10 G9 — ровно это показал браузерный A/B до
-- C4 (замерено ещё раз на чистом солвере: три сида, у каждого is_goal=true при
-- G9). Поймать это может только АБСОЛЮТНОЕ ожидание: настоящая раздача — 40 карт,
-- по одной каждого номинала 2..10 в трёх мастях, по 4 дракона на масть и цветок.
-- Отладочные раскладки и туториал 40 картами не являются ⇒ перепись включается
-- только при self.is_full_deal.
local CENSUS_SUITS = { "red", "blue", "green" }

local function census_expected()
   local exp, order = {}, {}
   local function want(key, n)
      exp[key] = n
      order[#order + 1] = key
   end
   for _, suit in ipairs(CENSUS_SUITS) do
      for v = 2, 10 do want(v .. "_" .. suit, 1) end
      want("d_" .. suit, 4)
   end
   want("f_flower", 1)
   return exp, order
end

-- Считает каждую карту доски ровно один раз: столбцы, ячейки (заблокированная —
-- это стопка из ЧЕТЫРЁХ драконов масти), foundation (номиналы 2..foundation_top)
-- и цветок. Проверяем мультимножество, а не сумму: две пятёрки и ни одной семёрки
-- дают ту же сумму, но это другая доска.
local function census_error(snap)
   local seen = {}
   local function add(value, suit, n)
      local key = tostring(value) .. "_" .. tostring(suit)
      seen[key] = (seen[key] or 0) + (n or 1)
   end
   for col = 1, 8 do
      for _, c in ipairs(snap.tableau[col] or {}) do add(c.value, c.suit) end
   end
   for ord = 1, 3 do
      local fc = snap.free_cells[ord]
      if fc and fc.card then
         if fc.blocked then add("d", fc.card.suit, 4) else add(fc.card.value, fc.card.suit) end
      end
   end
   for _, suit in ipairs(CENSUS_SUITS) do
      for v = 2, ((snap.foundation and snap.foundation[suit]) or 1) do add(v, suit) end
   end
   if snap.flower then add("f", "flower") end

   local exp, order = census_expected()
   for _, key in ipairs(order) do
      local got = seen[key] or 0
      if got ~= exp[key] then
         return string.format(
            "перепись не сошлась: карт %s на доске %d вместо %d — зеркала потеряли или задвоили карту",
            key, got, exp[key])
      end
      seen[key] = nil
   end
   for key, n in pairs(seen) do
      if n > 0 then
         return "перепись не сошлась: на доске лишняя карта " .. key .. " (" .. n .. " шт.)"
      end
   end
   return nil
end

-- Walk the live tableau into BOTH a solver snapshot and a parallel go_map of the
-- real card GO ids, with IDENTICAL filtering so that solver card[i] <-> GO[i]
-- stays an exact bijection (the director relies on this).
--
-- tableau_stacks is kept fresh by the tableau->main delta mirror
-- (tableau_card_added/removed), so auto-flown cards leave it on landing.
-- Two windows must still be reconciled:
--   * value-2 on a tableau top auto-foundations -> self.foundation_top reflects
--     it. So we read foundation from the live foundation_top, NOT {1,1,1}.
--   * an on-top flower may be MID-FLIGHT (drop_success fires on arc landing,
--     ~0.7s): until then it is still in the mirror. Exclude it from both the
--     snapshot and the go_map, and mark flower=true (as good as collected).
--
-- C4: free cells are read from self.free_cell_state (free_cell->main mirror), not
-- hardcoded empty any more — with C1 a parked dragon changes what collects are
-- legal, so a lie here makes the solver plan a different position than the one on
-- screen. Fourth return value is an error string: a board we cannot snapshot
-- honestly must refuse, not produce a plausible-looking wrong solve.
function snapshot_and_go_map(self)
   -- C5: цветок «помнится» отдельным флагом. Пока он лежит на верхушке столбца,
   -- его добавляет цикл ниже (окно полёта); после приземления карта уходит из
   -- зеркала tableau навсегда, и без flower_collected снапшот забывал бы её.
   local snap = { tableau = {}, free_cells = { {}, {}, {} }, flower = self.flower_collected or false }
   local go_map = { tableau = {}, free_cells = {} }
   local card_by_go = {}
   local err = nil
   for col = 1, 8 do
      snap.tableau[col] = {}
      go_map.tableau[col] = {}
      local stack = self.tableau_stacks[col]
      if stack then
         local n = #stack.cards
         for idx, c in ipairs(stack.cards) do
            local is_flower = (c.data.value == 'f') or c.data.is_flower
            if is_flower and idx == n then
               snap.flower = true  -- already auto-flew; not really on the tableau
            else
               table.insert(snap.tableau[col], { value = c.data.value, suit = c.data.suit })
               table.insert(go_map.tableau[col], c.id)
               card_by_go[c.id] = c
            end
         end
      end
   end
   -- Free cells. Empty stays {}; a parked card carries its GO so the director can
   -- fly it; a blocked cell is a collected dragon pile — replay must never target
   -- it, hence the BLOCKED sentinel instead of a GO (solver/replay.lua asserts on
   -- it). Snapshot field is `blocked` (bridge.lua contract), value/suit only —
   -- bridge.card derives the flags.
   for ord = 1, 3 do
      local fc = self.free_cell_state and self.free_cell_state[ord]
      local rec = fc and fc.card
      if rec and rec.data then
         local v, s = rec.data.value, rec.data.suit
         if v == 'f' or rec.data.is_flower then
            err = err or ("цветок припаркован в ячейке " .. ord .. " — солвер такую позицию не моделирует")
         end
         if fc.is_blocked then
            if v ~= 'd' then
               err = err or ("заблокированная ячейка " .. ord .. " держит не дракона (" .. tostring(v) .. ")")
            end
            snap.free_cells[ord] = { card = { value = v, suit = s }, blocked = true }
            go_map.free_cells[ord] = solver_replay.BLOCKED
         else
            if card_by_go[rec.id] then
               -- Один и тот же GO уже встречался — в tableau или в другой ячейке
               -- (второй случай возможен, пока зеркало догоняет очередь сообщений).
               err = err or ("карта из ячейки " .. ord .. " уже числится в другом месте доски — зеркала разъехались")
            end
            snap.free_cells[ord] = { card = { value = v, suit = s } }
            go_map.free_cells[ord] = rec.id
            card_by_go[rec.id] = rec
         end
      end
   end
   -- Сбор драконов сажает четыре карты на ячейку с задержкой (cursor: i*0.1 c).
   -- Первая уже приземлилась => ячейка blocked => bridge поставит
   -- dragons_collected[масть]=true, а остальные три этой масти ещё на столе.
   -- Гибрид «масть собрана + драконы той же масти лежат» — не позиция с экрана,
   -- и по нему нельзя ни решать, ни вести карты. Находка ревью grok-4.6;
   -- до C4 окна не было, потому что ячейки в снапшоте всегда были пусты.
   for ord = 1, 3 do
      local fc = snap.free_cells[ord]
      if fc and fc.blocked and fc.card then
         local suit = fc.card.suit
         for col = 1, 8 do
            for _, c in ipairs(snap.tableau[col]) do
               if c.value == 'd' and c.suit == suit then
                  err = err or ("масть " .. tostring(suit) .. " уже собрана в ячейке " .. ord ..
                     ", но её дракон ещё лежит в столбце " .. col .. " — сбор не доиграл до конца")
               end
            end
         end
         for other = 1, 3 do
            local o = snap.free_cells[other]
            if other ~= ord and o and o.card and not o.blocked
               and o.card.value == 'd' and o.card.suit == suit then
               err = err or ("масть " .. tostring(suit) .. " уже собрана в ячейке " .. ord ..
                  ", но её дракон ещё лежит в ячейке " .. other .. " — сбор не доиграл до конца")
            end
         end
      end
   end
   snap.foundation = {
      red = self.foundation_top.red, blue = self.foundation_top.blue, green = self.foundation_top.green,
   }
   -- Порядок гардов значим: специфичные (цветок в ячейке, blocked-не-дракон,
   -- дубль GO, недоигранный сбор) стоят ВЫШЕ переписи, а `err = err or ...`
   -- оставляет первый. При множественном рассинхроне человек в консоли увидит
   -- самую диагностичную причину, а не общее «карт не сошлось». Перестановка
   -- гардов молча ухудшит диагностику.
   if self.is_full_deal then
      err = err or census_error(snap)
   end
   return snap, go_map, card_by_go, err
end

-- 2c (console replay) needs only the snapshot.
function build_solver_snapshot(self)
   local snap, _, _, err = snapshot_and_go_map(self)
   return snap, err
end

-- Dev tool (press 'S'): solve the current deal and animate the solver's line of
-- play in the console, board-by-board (overlay-v1). Reuses board_view.render +
-- rules.apply_move (both tested), so it is independent of the live game state —
-- zero desync risk. Stage 2b drives the real cards.
function debug_solve(self)
   local snap, snap_err = build_solver_snapshot(self)
   if snap_err then
      print("[SOLVER] снапшот доски недостоверен: " .. snap_err .. " — решать не буду.")
      return
   end
   local state = solver_bridge.from_game(snap)
   print("[SOLVER] solving current deal (budget " .. SOLVE_BUDGET .. ") ...")
   local moves, status = solver_rules.solve(state, { node_budget = SOLVE_BUDGET })
   if status ~= "solved" then
      print("[SOLVER] " .. tostring(status) .. " — no solution within budget. Press SPACE for a new game.")
      return
   end
   local total = #moves
   print("[SOLVER] SOLVED in " .. total .. " moves — playing:")

   local function frame(st, n, desc)
      print(solver_view.render(st, { move_no = n, total = total, desc = desc, color = false }))
   end

   frame(state, 0, "deal")
   local i = 0
   local function step()
      i = i + 1
      if i > total then
         print("[SOLVER] " .. (solver_rules.is_win(state) and "WIN ✓" or "done") ..
            " (" .. total .. " moves)")
         return
      end
      state = solver_rules.apply_move(state, moves[i])
      frame(state, i, solver_view.describe(moves[i]))
      timer.delay(DEBUG_REPLAY_DELAY, false, step)
   end
   timer.delay(DEBUG_REPLAY_DELAY, false, step)
end

-- Dev tool (press 'R'): the solver DRIVES THE REAL CARDS through its line of
-- play (stage 2b). The pure planner (solver/replay.lua, unit-tested) precomputes
-- a flat directive list from a parallel go_map; this thin glue turns each
-- directive into the same drop_success / move_stack messages a human drag emits,
-- never reading the live game back. Cards the game auto-flies itself (flower +
-- value-2 on a tableau top) are flagged `auto` and skipped here.
function debug_replay(self)
   -- snapshot + parallel go_map from one shared walk (bijection guaranteed).
   local snap, go_map, card_by_go, snap_err = snapshot_and_go_map(self)
   if snap_err then
      print("[REPLAY] снапшот доски недостоверен: " .. snap_err .. " — вести карты не буду.")
      return
   end
   local state = solver_bridge.from_game(snap)
   local moves, status = solver_rules.solve(state, { node_budget = REPLAY_BUDGET })
   if status ~= "solved" then
      print("[REPLAY] " .. tostring(status) .. " — cannot drive this deal. Press SPACE for a new game.")
      return
   end

   local ok, directives = pcall(solver_replay.plan, state, moves, go_map)
   if not ok then
      print("[REPLAY] planner desync: " .. tostring(directives))
      return
   end
   print("[REPLAY] SOLVED in " .. #moves .. " moves — driving real cards (" .. #directives .. " directives).")

   -- Position helpers (director owns target slots; game obeys the slot_id it gets).
   local tableau_pos = get_tableau_positions(self)
   -- depth — 0-based место карты в колонке, значит после посадки в колонке будет
   -- depth+1 карт. G5: шаг больше не константа -35 (см. config.stack_offset_y),
   -- и захардкоженное значение промахивалось бы мимо реальной позиции тем
   -- сильнее, чем длиннее колонка. Дирижёр реплея обязан целиться туда же, куда
   -- потом посадит карту tableau_script.update_visible_cards.
   local function tcol(col, depth)
      local b = tableau_pos[col]
      local pitch = config.stack_offset_y(depth + 1, b.y)
      return "tableau_slot" .. col, vmath.vector3(b.x, b.y + depth * pitch, 0.2 + (depth + 1) * 0.001)
   end
   local function fcell(ord)
      local id = "free_slot" .. ord
      return id, self.free_slots[id].pos
   end
   -- Foundation slot per suit. The game binds these via cursor.base_slot_trace
   -- (cursor.script:30-34): each suit has a unique preferred base slot, so the
   -- binding is fixed (the auto-flown value-2 always lands on it). We mirror that
   -- exact mapping rather than first-empty, so a 3+ never races the 2's async
   -- card_to_base and lands on the wrong foundation.
   local BASE_OF_SUIT = { red = "base_slot1", blue = "base_slot2", green = "base_slot3" }
   local function base_for(suit) return BASE_OF_SUIT[suit] end

   local function dispatch(d)
      if d.auto then return end  -- game auto-flies it (flower / tableau value-2)

      if d.kind == "to_foundation" then
         local slot = base_for(d.suit)
         if not slot then print("[REPLAY] no base slot for " .. tostring(d.suit)); return end
         msg.post(d.card_go, "drop_success", {
            slot_id = slot, position = self.base_slots[slot].pos,
            card = card_by_go[d.card_go], animation = true })

      elseif d.kind == "to_free_cell" then
         local sid, pos = fcell(d.cell_ord)
         msg.post(d.card_go, "drop_success", {
            slot_id = sid, position = pos, card = card_by_go[d.card_go] })  -- no `complete` => parked, not blocked

      elseif d.kind == "from_free_cell" or d.kind == "tableau_to_tableau" or d.kind == "to_empty_tableau" then
         local sid, pos = tcol(d.to_col, d.to_depth)
         msg.post(d.card_go, "drop_success", {
            slot_id = sid, position = pos, card = card_by_go[d.card_go] })

      elseif d.kind == "multi_to_tableau" then
         -- replicate cursor.move_stack_cards: one drop_success per run card, in order
         for idx, go in ipairs(d.card_gos) do
            local sid, pos = tcol(d.to_col, d.to_depth + (idx - 1))
            msg.post(go, "drop_success", { slot_id = sid, position = pos, card = card_by_go[go] })
         end

      elseif d.kind == "dragon_collect" then
         -- replicate cursor.get_dragon_cards: all 4 dragons drop onto one cell,
         -- complete=true so the cell blocks (free_cell sets is_blocked once).
         local sid, pos = fcell(d.cell_ord)
         for _, go in ipairs(d.card_gos) do
            msg.post(go, "drop_success", {
               slot_id = sid, position = pos, card = card_by_go[go], complete = true })
         end
         local first = card_by_go[d.card_gos[1]]
         notify_dragon_button_collected(self, first and first.data and first.data.suit)
         -- Кнопку мы обошли — значит и её отложенный `dragons_collected` никто не
         -- пришлёт. А победа объявляется ИМЕННО на нём: ветка `card_to_base` при
         -- 27 картах во время реплея молчит (доской распоряжается дирижёр), и
         -- если масть собрана последним действием партии, стол остаётся пустым
         -- БЕЗ экрана победы. Поймано сценарием `win` 2026-08-23: реплей допечатал
         -- «WIN ✓ — all foundations complete», на скриншоте чистый стол, а
         -- платформе `GameplayAPI.stop` так и не ушёл. Задержка та же, что у
         -- кнопки (1.5 с): раньше драконы ещё летят, и зеркала ячеек не обновлены.
         timer.delay(1.5, false, function()
            msg.post("/card_table#main", "dragons_collected")
         end)
      end
   end

   self.debug_replaying = true
   msg.post(self.cursor, "disable_input")

   local i = 0
   local function finish()
      self.debug_replaying = false
      msg.post(self.cursor, "enable_input")
      -- Verify via foundation_top — the direct win criterion (all three suits
      -- topped at 10), independent of tableau bookkeeping.
      timer.delay(1.0, false, function()
         local ft = self.foundation_top
         if ft.red == 10 and ft.blue == 10 and ft.green == 10 then
            print("[REPLAY] WIN ✓ — all foundations complete (" .. #directives .. " directives).")
         else
            print(string.format("[REPLAY] DONE but NOT a win: R%s B%s G%s — check the line of play.",
               tostring(ft.red), tostring(ft.blue), tostring(ft.green)))
         end
      end)
   end
   local function step()
      i = i + 1
      if i > #directives then finish(); return end
      dispatch(directives[i])
      timer.delay(REPLAY_STEP_DELAY, false, step)
   end
   timer.delay(0.5, false, step)
end

-- C6: реплей собирает драконов прямыми `drop_success` — кнопка масти в этом пути
-- не участвует и о сборе не узнаёт: у неё остаётся `is_enable = true` с
-- `counter == 4`, и `check_state` снова зажигает её на ближайшем
-- `change_free_slots_button_counter`. Клик по такой кнопке отправляет четырёх уже
-- собранных драконов лететь в ту же заблокированную ячейку. Отдельная функция, а
-- не пара строк в dispatch, чтобы адресацию «масть → кнопка» можно было проверить
-- тестом: она держится на поле `sprite` из `get_dragon_buttons`, и мутация внутри
-- dispatch тест-копию логики не роняла (замерено).
function notify_dragon_button_collected(self, suit)
   if not suit or not self.dragon_buttons then return end
   for btn_id, btn in pairs(self.dragon_buttons) do
      if btn.sprite == suit then msg.post(btn_id, "collect_done") end
   end
end

function send_messages_to_cursor(self)
   msg.post(self.cursor, "set_cards", self.cards)
   msg.post(self.cursor, "set_free_slots", self.free_slots)
   msg.post(self.cursor, "set_base_slots", self.base_slots)
   msg.post(self.cursor, "set_flower_slot", self.flower_slot)
   msg.post(self.cursor, "set_tableau_slots", self.tableau_slots)
   msg.post(self.cursor, "set_dragon_buttons", self.dragon_buttons)
end

function send_message_to_dragon_buttons(self)
   for btn, value in pairs(self.dragon_buttons) do
      msg.post(btn, 'set_button', {data = value, cursor = self.cursor, slot_id = btn})
   end
end

function get_free_slots()
   return {
      free_slot1 = {pos = go.get_position('free_slot1'), dragon = nil, is_empty = true },
      free_slot2 = {pos = go.get_position('free_slot2'), dragon = nil, is_empty = true },
      free_slot3 = {pos = go.get_position('free_slot3'), dragon = nil, is_empty = true },
   }
end

function get_base_slots()
   return {
      base_slot1 = {pos = go.get_position('base_slot1'), is_empty = true },
      base_slot2 = {pos = go.get_position('base_slot2'), is_empty = true },
      base_slot3 = {pos = go.get_position('base_slot3'), is_empty = true },
   }
end

function get_tableau_slots(tutorial_mode)
   local empty_678 = tutorial_mode and true or false
   return {
      tableau_slot1 = {pos = go.get_position('tableau_slot1'), is_empty = false},
      tableau_slot2 = {pos = go.get_position('tableau_slot2'), is_empty = false},
      tableau_slot3 = {pos = go.get_position('tableau_slot3'), is_empty = false},
      tableau_slot4 = {pos = go.get_position('tableau_slot4'), is_empty = false},
      tableau_slot5 = {pos = go.get_position('tableau_slot5'), is_empty = false},
      tableau_slot6 = {pos = go.get_position('tableau_slot6'), is_empty = empty_678},
      tableau_slot7 = {pos = go.get_position('tableau_slot7'), is_empty = empty_678},
      tableau_slot8 = {pos = go.get_position('tableau_slot8'), is_empty = empty_678},
   }
end

function get_flower_slot()
   return {
      flower_slot = go.get_position('flower_slot'),
   }
end

function get_dragon_buttons()
   return {
      dragon_button1 = {sprite = 'red',   is_active = false, pos = go.get_position('dragon_button1')},
      dragon_button2 = {sprite = 'blue',  is_active = false, pos = go.get_position('dragon_button2')},
      dragon_button3 = {sprite = 'green', is_active = false, pos = go.get_position('dragon_button3')},
   }
end

function can_auto_finish(self, message)
   if self.tutorial_mode then return false end
   if self.auto_finishing then return false end
   if self.debug_replaying then return false end  -- director owns the board during 2b replay
   if self.currentState == self.states.WIN then return false end  -- review: defense-in-depth

   -- Проверяем free cells на драконов (blocked = собранные, их пропускаем)
   if message and message.free_cells then
      for _, fc in ipairs(message.free_cells) do
         if fc.dragon and not fc.is_blocked then
            return false
         end
      end
   end

   -- Собираем все оставшиеся карты из tableau
   local remaining = {}
   for i = 1, 8 do
      if self.tableau_stacks[i] then
         for _, card in ipairs(self.tableau_stacks[i].cards) do
            table.insert(remaining, card)
         end
      end
   end

   if #remaining == 0 then return false end

   for _, card in ipairs(remaining) do
      if card.data.is_dragon or card.data.is_flower then
         return false
      end
      local v = card.data.value
      local s = card.data.suit
      -- Safe check: другие масти не должны отставать более чем на 1
      local min_other = 10
      for suit, val in pairs(self.foundation_top) do
         if suit ~= s then
            min_other = math.min(min_other, val)
         end
      end
      if v > min_other + 1 then
         return false
      end
   end

   -- G3 (подтверждено обеими моделями ревью блока H). «Все карты безопасны» не
   -- значит «жадный съём верхушек их вынесет»: safe-проверка выше смотрит на
   -- ВСЕ карты колонок, а ход делает только find_next_auto_card — по верхушкам.
   -- Колонка [9_red, 10_red] при чужих фундаментах на 9 проходит safe целиком,
   -- но сверху лежит 10, а фундамент ждёт 9. Раньше это давало запуск
   -- авто-финиша, disable_input, паузу 0.5 с — и выход на первом же шаге.
   -- Требуем, чтобы ход был прямо сейчас: авто-финишу, которому нечего взять,
   -- начинать нечего. Частичное доигрывание при этом сохраняется — условие
   -- перепроверяется после каждого дропа.
   if not find_next_auto_card(self) then
      return false
   end

   return true
end

function find_next_auto_card(self)
   for i = 1, 8 do
      local stack = self.tableau_stacks[i]
      if stack and #stack.cards > 0 then
         local top_card = stack.cards[#stack.cards]
         if not top_card.data.is_dragon and not top_card.data.is_flower then
            local expected = self.foundation_top[top_card.data.suit] + 1
            if top_card.data.value == expected then
               return top_card, i
            end
         end
      end
   end
   return nil
end

-- Живые (не запечатанные) карты в свободных ячейках. Читает зеркало C4.
function live_cells(self)
   local n = 0
   for _, fc in ipairs(self.free_cell_state or {}) do
      if fc.card and not fc.is_blocked then n = n + 1 end
   end
   return n
end

-- Несобранные драконы: на столе или припаркованные в незапечатанной ячейке.
function dragons_left(self)
   local n = 0
   for i = 1, 8 do
      local stack = self.tableau_stacks and self.tableau_stacks[i]
      if stack then
         for _, card in ipairs(stack.cards) do
            if card.data and card.data.is_dragon then n = n + 1 end
         end
      end
   end
   for _, fc in ipairs(self.free_cell_state or {}) do
      -- G4: зеркало ячейки (free_cell.mirror_to_main) кладёт КАРТУ ЦЕЛИКОМ:
      -- { id = <go>, data = { value, suit } }. Здесь читалось fc.card.value —
      -- на боевой форме это всегда nil, то есть припаркованный дракон не
      -- считался никогда. Ветку прикрывал live_cells (ему достаточно факта
      -- fc.card), поэтому ложной победы не было, но retry-ветка в
      -- dragons_collected опиралась на заниженный счётчик.
      -- snapshot_and_go_map читает ту же форму через rec.data.value.
      local data = fc.card and fc.card.data
      if data and not fc.is_blocked and data.value == "d" then n = n + 1 end
   end
   return n
end

-- Настоящее условие победы: все номиналы в foundation, ячейки свободны от живых
-- карт, драконов на столе не осталось, ЦВЕТОК В СВОЁМ СЛОТЕ. Это то же самое,
-- что считает целью солвер — раньше игра и её эталон расходились.
--
-- Точности ради (поймано ревью блока L): формулы РАЗНЫЕ. `rules.is_goal` —
-- «tableau пуст И живых карт в ячейках нет», foundation и цветок он не считает
-- вовсе (нужно для мини-раздач). На ПОЛНОЙ раздаче они эквивалентны по
-- следствию: 27 номиналов + собранные драконы + цветок в слоте — это и есть
-- пустой стол, и наоборот. Совпадение по следствию, не по записи.
--
-- Про цветок (внешнее ревью 2026-08-23, подтверждено зондом на этой функции).
-- Без последнего условия board_cleared давал true, пока цветок ещё лежал в
-- колонке: 27 номиналов уже в foundation, драконов нет, ячейки пусты — а
-- единственная оставшаяся карта в счёт не шла. Практический эффект: 27-я карта
-- приходит через card_to_base в том же кадре, а цветок улетает только со
-- следующего tableau.update, то есть Victory показывался НА КАДР РАНЬШЕ правила,
-- поверх живого цветка. Теперь эта ветка уходит в begin_auto_collect, и победу
-- объявляет тот же путь, что уже умеет дожидаться посадки цветка
-- (auto_collect_give_up, SETTLE_SECONDS).
function board_cleared(self)
   return (self.base_cards_count or 0) >= 27
      and live_cells(self) == 0
      and dragons_left(self) == 0
      and (self.flower_collected or false)
end

-- G7: какого дракона сдвинуть и на какую пустую колонку, чтобы открыть
-- лежащего под ним. Кнопка масти горит только при ЧЕТЫРЁХ открытых драконах
-- (верхушки колонок + незапечатанные ячейки), поэтому дракон под драконом не
-- поднимает счётчик, и без сдвига партия не доигрывается: замер
-- reviews/probe_dragon_unblock.lua, сиды 1..300 — из 99 партий, доходящих до
-- foundation=27 при живых драконах, одним лишь сбором доигрываются 69, со
-- сдвигом на пустую колонку — все 99, столько же даёт полный перебор.
-- (Числа менялись дважды: сначала выборка была 60 сидов, потом в зонде не
-- хватало автоулёта цветка — оба раза поймано ревью. Это те, что стоят на
-- текущем зонде.)
--
-- Источник обязан иметь под собой ещё карту (#cards >= 2). Это не украшение:
-- каждый такой сдвиг уменьшает число закопанных карт ровно на единицу, поэтому
-- цепочка конечна и не может зациклиться, гоняя одинокого дракона между двумя
-- пустыми колонками. Берём самую высокую колонку — так закопанные вскрываются
-- быстрее всего.
--
-- Возвращает (карта, slot_id) или nil, если сдвигать нечего или некуда.
function dragon_relocation(self)
   local empty_slot = nil
   for i = 1, 8 do
      local st = self.tableau_stacks and self.tableau_stacks[i]
      if st and #st.cards == 0 then
         empty_slot = st.slot_id
         break
      end
   end
   if not empty_slot then return nil end

   local best, best_depth = nil, 1
   for i = 1, 8 do
      local st = self.tableau_stacks and self.tableau_stacks[i]
      local cards = st and st.cards
      if cards and #cards >= 2 and #cards > best_depth then
         local top = cards[#cards]
         if top.data and top.data.is_dragon then
            best, best_depth = top, #cards
         end
      end
   end
   if not best then return nil end
   return best, empty_slot
end

-- G4: на время авто-сбора ввод глушится (курсор делит pending_drop с пальцем).
-- Флаг нужен, чтобы вернуть ввод ровно тому, кто его забрал: у auto-finish свой
-- замок (start_auto_finish), и снимать его отсюда нельзя.
function begin_auto_collect(self)
   self.auto_collecting = true
   self.auto_collect_wait = 0
   msg.post(self.cursor, "auto_collect_dragons")
end

function end_auto_collect(self)
   if self.auto_collecting then
      self.auto_collecting = false
      msg.post(self.cursor, "enable_input")
   end
end

-- G7/G2a: доигрывать нечем — ни собрать масть, ни сдвинуть дракона.
--
-- G4: авто-сбор глушит ввод на время сбора (pending_drop общий с пальцем).
-- Управление игроку возвращаем ЗДЕСЬ, до решения о победе: иначе при отказе от
-- победы (туториал, < 27) стол останется глухим навсегда. Через
-- end_auto_collect, а не напрямую: у auto-finish свой замок, и снимать чужой мы
-- не имеем права.
--
-- Победу засчитываем: все номиналы разложены, партия выиграна по существу, и
-- руками игрок тоже ничего сделать не может.
--
-- ⚠ Ревью блока H (grok-4.5) справедливо поймало прежний комментарий на вранье:
-- он обещал «ни пустой колонки, ни свободной ячейки», а dragon_relocation
-- свободные ячейки не читает вообще — только пустые колонки. Формулировка
-- исправлена, КОД оставлен как есть, и вот почему.
--
-- Замер, reviews/probe_dragon_unblock.lua, сиды 1..300: партий, дошедших до
-- foundation=27 с живыми драконами — 99. Политика игры (сбор + сдвиг верхнего
-- дракона на пустую колонку) доигрывает до пустого стола ВСЕ 99, ровно столько
-- же даёт полный перебор, в который сдвиг в ЯЧЕЙКУ входит. Уступка не
-- срабатывает НИ РАЗУ — это хвост, а не рабочая ветка.
--
-- ⚠ История этих цифр — предупреждение самому себе. Сначала здесь стояло
-- «97 из 99, две доски безнадёжны», и на этом основании ветка «сдвиг в ячейку»
-- была отвергнута. Ревью блока I (grok-4.6) сняло обе «безнадёжные» доски и
-- показало: в наборе ходов зонда не было АВТОУЛЁТА ЦВЕТКА, а в игре цветок с
-- верхушки улетает сам. Перебор честно упирался в доски, где сверху лежит
-- цветок. С этим ходом обе доигрываются, и уступок не остаётся вовсе.
-- Вывод «ячейка не спасает» устоял (B = C = потолок), но опирается он теперь
-- на другой замер, а не на тот, что был написан здесь раньше.
-- Ревью блока I (grok-4.6): сдаваться, пока цветок ещё на столе, — рано.
-- Цветок улетает САМ, но на СЛЕДУЮЩЕМ кадре (tableau_script ставит
-- pending_top_check и шлёт send_to_flower_slot из своего update). Если 27-я
-- карта лежала на цветке, то в том же проходе, где мы просим авто-сбор, цветок
-- ещё сверху: dragon_relocation его не двигает (верхушка не дракон), кнопка не
-- горит (четвёртый дракон под цветком) — и уступка объявляла победу поверх
-- живых драконов ровно за кадр до того, как всё разрешилось бы само.
-- Ждём и переспрашиваем; бюджет ограничен, чтобы закопанный намертво цветок
-- (или припаркованный игроком в ячейку — flower_collected тогда не придёт
-- никогда) не держал партию вечно.
--
-- ⚠ Бюджет считается в СЕКУНДАХ, а не в кадрах. Первая версия ждала 8 попыток
-- по 4 кадра и была бита ревью блока J (grok-4.5) арифметикой: 32 кадра при
-- 60 fps — это 0.53 с, а цветок летит 0.35 + 0.35 = 0.7 с (fly_card_arc), и
-- flower_collected приходит только из flower_slot.occupy_slot, то есть ПОСЛЕ
-- посадки. Победа успевала объявиться прямо посреди дуги. На 120 Гц кадровый
-- бюджет был бы вдвое короче — ещё хуже.
-- 2 секунды: полёт 0.7 с плюс запас на задержку старта дуги.
--
-- И отдельный запас ПОСЛЕ посадки — ревью блока J (grok-4.6). Прошлая версия
-- обещала этот запас в комментарии, но не делала: ожидание жило только пока
-- `not flower_collected`, а флаг взводится в тот же кадр, что и посадка
-- (flower_slot.occupy_slot). Кнопка же загорается ПОЗЖЕ и другим путём:
-- remove_card ставит pending_top_check → следующий tableau.update шлёт
-- send_counter_to_button → dragon_button.check_state → set_button_state курсору.
-- Порядок обновления игровых объектов в Defold не фиксирован, так что курсор
-- вполне может прочитать ещё погасшую кнопку и ответить auto_collect_none — и
-- уступка объявляла победу за кадр до того, как кнопка зажжётся.
-- Поэтому таймер обнуляется на посадке цветка (см. обработчик flower_collected)
-- и после неё даётся короткий SETTLE_SECONDS на эту цепочку.
--
-- Читать таймер надо как «сколько времени на доске НИЧЕГО не происходит»:
-- он обнуляется на каждом событии, после которого может появиться ход:
-- старт сбора, посадка цветка, посадка сдвинутого дракона. Собранная масть в
-- этот список не входит напрямую — она либо заканчивает партию, либо начинает
-- новый заход begin_auto_collect, который обнуляет таймер сам (уточнение из
-- ревью блока K: прежняя формулировка была шире кода).
-- Пока события идут, уступка не срабатывает; общее время всё равно ограничено
-- бюджетом сдвигов (auto_collect_moves <= 24).
local FLOWER_WAIT_SECONDS = 2.0
local SETTLE_SECONDS = 0.3

function auto_collect_give_up(self)
   local budget = self.flower_collected and SETTLE_SECONDS or FLOWER_WAIT_SECONDS
   if (self.auto_collect_wait or 0) < budget then
      self.pending_collect_retry = 4
      return
   end
   end_auto_collect(self)
   -- Здесь НЕ board_cleared, и это не забывчивость. Ветка уступки — запасной
   -- выход G2a: авто-сбор невозможен, драконы на столе, ходов у игрока нет.
   -- Требовать здесь чистый стол значит вместо победы отдать игроку софт-лок —
   -- ввод вернули, а сделать нечем. Шесть тестов держат именно это решение.
   --
   -- Но `live_cells == 0` добавлено (внешнее ревью 2026-08-23 + зонд на живой
   -- функции): при карте в НЕзапечатанной ячейке уступка объявляла победу, хотя
   -- у игрока ход есть — эту карту можно вытащить. Реальный случай — цветок,
   -- пойманный в ячейку в окно H6: его сюда роняет собственный авто-улёт, и
   -- Victory показывался поверх непустой ячейки. Дракон в ячейке под тот же
   -- случай не подпадает: запечатанная ячейка live_cells не считает.
   if not self.tutorial_mode and (self.base_cards_count or 0) >= 27
      and live_cells(self) == 0 then
      declare_victory(self)
   end
end

function declare_victory(self)
   if self.currentState == self.states.WIN then return end
   -- Замок авто-сбора снимаем на ЛЮБОЙ победе, а не только в ветке отказа.
   -- Сегодня это гигиена состояния, а не баг: карты после победы всё равно
   -- мертвы (tutorial_state.request_victory ставит липкий block_play_input,
   -- cursor.on_input выходит по нему первой строкой), а любой путь обратно в
   -- партию — restart_level / Space / MENU+PLAY — идёт через game_manager.show,
   -- то есть выгружает и заново грузит коллекцию вместе с курсором. Но
   -- оставлять auto_collecting=true у выжившего состояния значит держать мину
   -- под тем, кто однажды сделает победу без перезагрузки уровня.
   end_auto_collect(self)
   self.currentState = self.states.WIN
   sfx.victory()
   tutorial_state.request_victory()
end

function auto_finish_step(self)
   local card, stack_index = find_next_auto_card(self)
   if not card then
      self.auto_finishing = false
      msg.post(self.cursor, "enable_input")
      -- Проверяем победу: все tableau пусты = все карты в foundation
      local all_empty = true
      for i = 1, 8 do
         if self.tableau_stacks[i] and #self.tableau_stacks[i].cards > 0 then
            all_empty = false
            break
         end
      end
      -- Пустой стол — ещё НЕ победа: карта могла быть припаркована в свободной
      -- ячейке, а авто-финиш ячейки не разгребает (find_next_auto_card смотрит
      -- только верхушки колонок). Без этой проверки партия с 10_red в ячейке и
      -- 26 картами в foundation объявлялась выигранной, оверлей глушил ввод и
      -- доложить последнюю карту было уже нельзя. Найдено независимым ревью
      -- (grok-4.6), воспроизведено тестом на этом самом коде.
      -- Читаем зеркало C4: blocked-ячейка = собранные драконы, она победе не мешает.
      local cell_occupied = false
      for _, fc in ipairs(self.free_cell_state or {}) do
         if fc.card and not fc.is_blocked then
            cell_occupied = true
            break
         end
      end
      -- 27-я карта уже ставит WIN через card_to_base — не дублируем victory
      if all_empty and not cell_occupied and self.base_cards_count > 0
         and self.currentState ~= self.states.WIN then
         print("[MAIN] auto-finish complete — victory!")
         self.currentState = self.states.WIN
         sfx.victory()
         tutorial_state.request_victory()
      end
      return
   end

   local target_slot = self.suit_to_base[card.data.suit]
   if not target_slot then
      -- Масть ещё не в foundation — ищем свободный base_slot
      for slot_id, sl in pairs(self.base_slots) do
         if sl.is_empty then
            target_slot = slot_id
            break
         end
      end
   end

   if not target_slot then
      -- Нет доступного слота — останавливаем
      self.auto_finishing = false
      msg.post(self.cursor, "enable_input")
      return
   end

   sfx.auto_finish()
   msg.post(card.id, "drop_success", {
      slot_id = target_slot,
      position = self.base_slots[target_slot].pos,
      card = card,
      animation = true
   })

   -- Локальное удаление для немедленной консистентности find_next_auto_card;
   -- зеркальный tableau_card_removed придёт позже и no-op'нется (поиск по id).
   table.remove(self.tableau_stacks[stack_index].cards)

   timer.delay(0.4, false, function()
      auto_finish_step(self)
   end)
end

function start_auto_finish(self)
   self.auto_finishing = true
   msg.post(self.cursor, "disable_input")
   timer.delay(0.5, false, function()
      auto_finish_step(self)
   end)
end

function on_message(self, message_id, message, sender)
   if message_id == hash("card_to_base") then
      self.base_cards_count = (self.base_cards_count or 0) + 1
      if message.suit and message.value then
         self.foundation_top[message.suit] = message.value
      end
      if message.suit and message.slot_id and not self.suit_to_base[message.suit] then
         self.suit_to_base[message.suit] = message.slot_id
      end
      if not self.tutorial_mode and self.base_cards_count >= 27 then
         -- Все 27 номиналов разложены — но это ещё не пустой стол. Замер
         -- (reviews/probe_dragon_unblock.lua, сиды 1..300): в 99 решённых
         -- партиях в этот момент на столе остаются живые драконы, и раньше игра
         -- показывала Victory прямо поверх них. Число обновлено вместе с
         -- зондом — на выборке из 60 сидов тут стояло «15 из 57». Доигрываем драконов сами; победу объявит проверка на
         -- `dragons_collected` (тот же путь, что и при ручном сборе, — если
         -- авто-нажатие почему-то не сработает, игрок дожмёт кнопки руками и
         -- всё равно выиграет).
         if board_cleared(self) then
            declare_victory(self)
         elseif not self.debug_replaying then
            -- Во время реплея солвера доской распоряжается директор: он сам
            -- собирает драконов своими директивами. Влезть сюда с авто-сбором
            -- значит собрать масть раньше директивы и рассинхронить план —
            -- та же причина, по которой отказывает can_auto_finish (стр. 858).
            begin_auto_collect(self)
         end
      end
      -- B2: авто-улёт двойки поднимает foundation без хода игрока — перепроверяем
      -- auto-finish (round-trip через cursor даёт свежие free_cells).
      if not self.tutorial_mode and not self.auto_finishing
         and self.currentState ~= self.states.WIN then
         msg.post(self.cursor, "send_auto_finish_check")
      end
   elseif message_id == hash("tableau_card_added") then
      -- B: дельта-зеркало от tableau_script — main.tableau_stacks всегда свежее
      local stack = self.tableau_stacks[message.index]
      if stack then
         table.insert(stack.cards, message.card)
      end
   elseif message_id == hash("tableau_card_removed") then
      local stack = self.tableau_stacks[message.index]
      if stack then
         for j = #stack.cards, 1, -1 do
            if stack.cards[j].id == message.id then
               table.remove(stack.cards, j)
               break
            end
         end
      end
   elseif message_id == hash("free_cell_changed") then
      -- C4: содержимое ячейки изменилось. message.card отсутствует => ячейка пуста
      -- (Defold не переносит nil-поля).
      local ord = FREE_CELL_ORD[tostring(message.slot_id)]
      if ord then
         self.free_cell_state[ord] = { card = message.card, is_blocked = message.is_blocked or false }
      else
         print("[SNAPSHOT] free_cell_changed от неизвестной ячейки: " .. tostring(message.slot_id))
      end
   elseif message_id == hash("flower_collected") then
      -- C5: см. flower_slot.script. Флаг только взводится: обратно цветок из слота
      -- не достаётся, а новая партия перезагружает коллекцию (init сбрасывает).
      self.flower_collected = true
      -- Посадка цветка открыла карту под ним. Даём цепочке «верхушка → счётчик →
      -- кнопка → курсор» отработать, прежде чем уступка решит, что ходов нет:
      -- таймер ожидания считается с этого момента (ревью блока J).
      self.auto_collect_wait = 0
   elseif message_id == hash("check_auto_finish") then
      -- B2: не оцениваем немедленно — каскад drop_success→remove_card→зеркало и
      -- card_to_base ещё в очереди сообщений. Откладываем на 2 кадра в update().
      self.pending_af_check = { free_cells = message.free_cells, frames = 2 }
   elseif message_id == hash("auto_collect_none") then
      -- Курсор доложил: ни одной горящей кнопки с посадочной ячейкой.
      -- G7: раньше здесь сразу объявлялась победа поверх живых драконов. Теперь
      -- сначала пробуем ОТКРЫТЬ закопанного дракона, сдвинув лежащего на нём на
      -- пустую колонку — и только если сдвигать нечего или некуда, уступаем.
      local card, slot_id = dragon_relocation(self)
      local budget = (self.auto_collect_moves or 0) < 24   -- страховка от петли
      if card and slot_id and budget and not self.tutorial_mode and not self.debug_replaying then
         self.auto_collect_moves = (self.auto_collect_moves or 0) + 1
         msg.post(self.cursor, "auto_move_dragon", { card = card, slot_id = slot_id })
      else
         auto_collect_give_up(self)
      end
   elseif message_id == hash("auto_collect_moved") then
      -- Дракон сел на пустую колонку. Считать заново нельзя немедленно: в
      -- очереди ещё occupy_slot/remove_card, а счётчик кнопки поднимет
      -- last_card_to_slot из update() слота (A6). Ждём осадки кадров.
      self.pending_collect_retry = 4
      -- И сбрасываем таймер простоя: на доске только что произошло событие,
      -- дающее новый ход. Без этого сдвиг дракона (дуга 0.7 с) успевал сжечь
      -- весь запас ещё в полёте, и первый же отказ после посадки уходил в
      -- уступку — та же дыра, что с цветком, только другим путём.
      self.auto_collect_wait = 0
   elseif message_id == hash("auto_collect_none_final") then
      -- Курсор не смог выполнить сдвиг (слот исчез, пока летело сообщение).
      auto_collect_give_up(self)
   elseif message_id == hash("dragons_collected") then
      if self.tutorial_mode then
         self.currentState = self.states.WIN
         sfx.victory()
         tutorial_state.request_victory()
      elseif board_cleared(self) then
         -- Последняя масть драконов улетела в ячейку — стол пуст, это победа.
         -- Единственная точка, где партия выигрывается после авто-сбора; сюда же
         -- приходит ручной сбор, поэтому оба пути закрыты одним условием.
         declare_victory(self)
      else
         -- После сбора драконов проверяем auto-finish
         msg.post(self.cursor, "send_auto_finish_check")
         -- Драконы могли собраться не все (ячейка освободилась только сейчас) —
         -- дожимаем оставшиеся кнопки, если номиналы уже все в foundation.
         if (self.base_cards_count or 0) >= 27 and dragons_left(self) > 0
            and not self.debug_replaying then
            begin_auto_collect(self)   -- ввод остаётся глухим до конца цепочки
         else
            end_auto_collect(self)     -- G4: цепочка кончилась, вернуть управление
         end
      end
   elseif message_id == hash("debug_solve") then
      if DEBUG_SOLVER then debug_solve(self) end
   elseif message_id == hash("debug_replay") then
      if DEBUG_SOLVER then debug_replay(self) end
   end
end

function update(self, dt)
   -- Poll queued sounds from GUI (cross-collection workaround)
   if sfx.pending then
      sound.play("sound_manager#" .. sfx.pending)
      sfx.pending = nil
   end
   -- B2: отложенная оценка auto-finish — к этому кадру зеркало tableau
   -- и foundation_top уже осели после хода.
   if self.pending_af_check then
      self.pending_af_check.frames = self.pending_af_check.frames - 1
      if self.pending_af_check.frames <= 0 then
         local check = self.pending_af_check
         self.pending_af_check = nil
         if can_auto_finish(self, check) then
            print("[MAIN] can_auto_finish = true — starting auto-finish")
            start_auto_finish(self)
         end
      end
   end
   -- G7: следующий шаг авто-сбора после сдвига дракона. Отложено на кадры по
   -- той же причине, что и pending_af_check: счётчик кнопки поднимается из
   -- update() слота, а не в момент drop_success.
   -- Бюджет ожидания тикает по времени, а не по кадрам: на 120 Гц кадровый
   -- счётчик отмерил бы вдвое меньше реального (ревью блока J).
   if self.auto_collecting then
      self.auto_collect_wait = (self.auto_collect_wait or 0) + (dt or 0)
   end
   if self.pending_collect_retry then
      self.pending_collect_retry = self.pending_collect_retry - 1
      if self.pending_collect_retry <= 0 then
         self.pending_collect_retry = nil
         if self.auto_collecting then
            msg.post(self.cursor, "auto_collect_dragons")
         end
      end
   end
end
