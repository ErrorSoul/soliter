local sfx = require("main.Scripts.sfx")
local ui_fx = require("main.Scripts.ui_fx")

function init(self)
   self.sprite = nil
   self.default_sprite = 'grey'
   self.is_active = nil
   self.counter = 0
   self.free_slot_pos = nil
   self.cards = {}
   self.free_slots_counter = 3
   self.cursor = nil
   self.slot_it = nil
   self.is_enable = true
end

function on_message(self, message_id, message, sender)
   if message_id == hash("set_button") then
      self.is_active = message.data.is_active
      self.sprite = message.data.sprite
      self.default_sprite = message.data.sprite .. "_grey"
      self.cursor = message.cursor
      self.slot_id = message.slot_id
      check_state(self)
   elseif message_id == hash("send_counter_to_button") then
      -- A6: last_card_to_slot зовётся и из occupy_slot, поэтому один и тот же дракон
      -- приходит повторно (перенос верхушки-дракона на пустую колонку). Счётчик
      -- сравнивается с 4 ТОЧНО и никогда не декрементится, так что повторный счёт либо
      -- зажигает кнопку рано с дублем в self.cards, либо перескакивает 4 и гасит её
      -- навсегда. check_state на пропущенном пути НЕ зовём: состояние не изменилось,
      -- а лишний вызов сбросил бы pingpong-анимацию.
      for _, c in ipairs(self.cards) do
         if c.id == message.id then return end
      end
      self.counter = self.counter + 1
      table.insert(self.cards, message)
      check_state(self)
   elseif message_id == hash("get_dragon_cards") then
      if not self.is_enable then return end
      sfx.dragon_collect()
      msg.post(self.cursor, 'get_dragon_cards', self.cards)
      self.is_enable = false
      check_state(self)
      -- Задержка: ждём окончания дуги драконов (~0.7s) + полёта цветка (~0.5s)
      timer.delay(1.5, false, function()
         msg.post("/card_table#main", "dragons_collected")
      end)
   elseif message_id == hash("collect_failed") then
      -- G4: курсор не нашёл ячейку, куда посадить масть (кнопки горят по общему
      -- счётчику свободных ячеек, а сядут драконы в конкретную). Сбор не
      -- состоялся — возвращаем кнопку в строй, иначе она останется навсегда
      -- потушенной при counter == 4. Отложенный dragons_collected отменить
      -- нельзя, но он безвреден: main просто пересчитает стол.
      self.is_enable = true
      check_state(self)
   elseif message_id == hash("collect_done") then
      -- C6: масть собрали МИМО кнопки — так делает реплей солвера (`debug_replay`
      -- шлёт четырём драконам `drop_success{complete=true}` напрямую, повторяя
      -- `cursor.get_dragon_cards`, но саму кнопку не трогает). Без этого сообщения
      -- у кнопки остаётся `is_enable = true` и `counter == 4`, и первый же
      -- `change_free_slots_button_counter` снова зажигает её: клик отправляет
      -- четыре уже собранных дракона лететь в ту же заблокированную ячейку.
      -- Ставим то же состояние КНОПКИ, что и человеческий путь. Отложенный
      -- `dragons_collected` здесь по-прежнему НЕ шлём — но не потому, что он не
      -- нужен: его шлёт сам main из `notify_dragon_button_collected`, с той же задержкой
      -- 1.5 с. Прежняя формулировка «main и так знает про сбор» была неверна и
      -- стоила экрана победы: знать мало, победа объявляется на этом сообщении
      -- (см. комментарий в dispatch, ветка `dragon_collect`).
      self.is_enable = false
      check_state(self)
   elseif message_id == hash("highlight") then
      ui_fx.highlight(1.15)
   elseif message_id == hash("unhighlight") then
      ui_fx.unhighlight()
   elseif message_id == hash("change_free_slots_button_counter") then
      self.free_slots_counter = self.free_slots_counter + message.num

      check_state(self)
   end
end


function check_state(self)
   if self.is_enable and self.counter == 4 and free_slot_any(self) then
      msg.post("#sprite", "play_animation", {id = hash("button" .. "_" .. self.sprite)})
      msg.post(self.cursor, 'set_button_state', {slot_id = self.slot_id, is_active = true})
      go.cancel_animations(".", "scale")
      go.animate(".", "scale", go.PLAYBACK_LOOP_PINGPONG,
          vmath.vector3(1.15, 1.15, 1), go.EASING_INSINE, 0.5)
   else
      msg.post("#sprite", "play_animation", {id = hash("button" .. "_" .. self.default_sprite)})
      msg.post(self.cursor, 'set_button_state', {slot_id = self.slot_id, is_active = false})
      go.cancel_animations(".", "scale")
      go.set(".", "scale", vmath.vector3(1, 1, 1))
   end
end

function free_slot_any(self)
   --return self.free_slot_pos or self.free_slots_counter > 0
   return self.free_slots_counter > 0
end
