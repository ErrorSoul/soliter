local tutorial_state = require("main.Scripts.tutorial_state")
local i18n = require("main.Scripts.i18n")
local sfx = require("main.Scripts.sfx")
local celebration = require("main.Scripts.celebration")
local theme = require("main.Scripts.theme")

local function theme_color(name, alpha)
    local c = theme[name]
    return vmath.vector4(c[1], c[2], c[3], alpha or 1)
end

local function restart_level(preserve_save)
   msg.post("/main#game_manager", "restart_level", { preserve_save = preserve_save == true })
end

-- v3: строка подсказки — это ТИП хода, который солвер нашёл на текущей доске
-- (tutorial_state.hint.kind), а не номер шага сценария. Пока подсказки нет
-- (первые кадры после раздачи, окно рассинхрона зеркал) показываем цель партии:
-- она верна всегда, а пустая строка читалась бы как «туториал сломался».
-- Счётчик под текстом раньше был «шаг N из 5» — число, которое врало при любом
-- ходе игрока мимо сценария. Теперь это расстояние до победы: сколько ходов
-- осталось, если играть по подсказке.
local function update_tutorial_hint()
    local hint = tutorial_state.hint
    local text
    if tutorial_state.hint_status == "stuck" then
        text = i18n.t("tutorial_stuck")
    elseif hint then
        text = i18n.t("tutorial_hint_" .. hint.kind)
    else
        text = i18n.t("tutorial_goal")
    end
    gui.set_text(gui.get_node("tutorial_text"), text)
    gui.set_text(gui.get_node("tutorial_step_text"),
        hint and string.format(i18n.t("tutorial_moves_left"), hint.distance) or "")
end

-- H3: статические подписи живут в ui.gui как английский хардкод. Проставляем их
-- здесь, в одном месте: иначе перевод жил бы в двух источниках сразу, и любой
-- новый язык надо было бы вносить ещё и в .gui руками.
local STATIC_LABELS = {
    restart_text       = "restart",
    restart_text1      = "tutorial",
    title_text         = "title",
    play_text          = "play",
    victory_menu_text  = "menu",
    tutorial_skip_text = "skip",
    start_tutorial_text = "tutorial",
    start_eyebrow      = "menu_eyebrow",
    start_caption     = "menu_caption",
    start_footer      = "menu_footer",
    victory_footer    = "victory_footer",
}

-- Тексты экрана победы зависят от режима (туториал / обычная партия), поэтому
-- живут отдельной функцией: их проставляет и сам экран победы, и перекраска
-- языка. Раньше они были заинлайнены в update, и при позднем языке от SDK
-- заголовок оставался на старом языке рядом с уже переведённой кнопкой MENU
-- (находка внешнего ревью D1).
local function apply_victory_texts()
    if tutorial_state.is_tutorial then
        gui.set_text(gui.get_node("text1"), i18n.t("well_done"))
        gui.set_text(gui.get_node("text"), i18n.t("play_now"))
        gui.set_text(gui.get_node("victory_caption"), i18n.t("practice_complete"))
    else
        gui.set_text(gui.get_node("text1"), i18n.t("victory"))
        gui.set_text(gui.get_node("text"), i18n.t("play_again"))
        gui.set_text(gui.get_node("victory_caption"), i18n.t("board_complete"))
    end
end

local function apply_language()
    i18n.set_lang(i18n.detect())
    for node_id, key in pairs(STATIC_LABELS) do
        gui.set_text(gui.get_node(node_id), i18n.t(key))
    end
    -- Динамические подписи тоже перекрашиваем: язык от SDK приезжает асинхронно
    -- и может застать открытым туториал или экран победы. Ноды могут быть
    -- выключены — gui.set_text это не мешает.
    update_tutorial_hint()
    apply_victory_texts()
    print("[I18N] язык: " .. tostring(i18n.lang))
end

function init(self)
    msg.post(".", "acquire_input_focus")
    apply_language()
    msg.post("@render:", "clear_color", {color = theme_color("background")})
    -- Скрыть игровые кнопки до начала игры
    gui.set_enabled(gui.get_node("hud_rail"), false)
    gui.set_enabled(gui.get_node("restart_button"), false)
    gui.set_enabled(gui.get_node("tutorial_button"), false)
    -- Victory overlay скрыт по умолчанию
    gui.set_enabled(gui.get_node("victory_overlay"), false)
    -- Tutorial overlay скрыт по умолчанию
    gui.set_enabled(gui.get_node("tutorial_overlay"), false)
    -- Стартовый экран включён по умолчанию
    self.game_started = false
end

function on_input(self, action_id, action)
    if action_id == hash("touch") and action.pressed then
        -- Обработка стартового экрана
        if not self.game_started then
            local play_button = gui.get_node("play_button")
            if gui.pick_node(play_button, action.x, action.y) then
                sfx.button_click()
                gui.set_enabled(gui.get_node("start_screen"), false)
                gui.set_enabled(gui.get_node("hud_rail"), true)
                gui.set_enabled(gui.get_node("restart_button"), true)
                gui.set_enabled(gui.get_node("tutorial_button"), true)
                msg.post("/main#game_manager", "start_game")
                self.game_started = true
            elseif gui.pick_node(gui.get_node("start_tutorial_button"), action.x, action.y) then
                sfx.button_click()
                tutorial_state.is_tutorial = true
                tutorial_state.reset()
                gui.set_enabled(gui.get_node("start_screen"), false)
                gui.set_enabled(gui.get_node("tutorial_overlay"), true)
                update_tutorial_hint()
                -- start_game loads the tutorial without erasing the normal save.
                msg.post("/main#game_manager", "start_game")
                self.game_started = true
            end
            return true
        end

        -- SKIP во время туториала
        if tutorial_state.is_tutorial and gui.is_enabled(gui.get_node("tutorial_overlay")) then
            if gui.pick_node(gui.get_node("tutorial_skip_btn"), action.x, action.y) then
                sfx.button_click()
                tutorial_state.is_tutorial = false
                tutorial_state.reset()
                gui.set_enabled(gui.get_node("tutorial_overlay"), false)
                gui.set_enabled(gui.get_node("hud_rail"), true)
                gui.set_enabled(gui.get_node("restart_button"), true)
                gui.set_enabled(gui.get_node("tutorial_button"), true)
                restart_level(true)
                return true
            end
        end

        -- Victory overlay
        local victory_overlay = gui.get_node("victory_overlay")
        if gui.is_enabled(victory_overlay) then
            local restart = gui.get_node("victory_restart")
            local menu = gui.get_node("victory_menu_button")

            if tutorial_state.is_tutorial and gui.pick_node(restart, action.x, action.y) then
                -- После обучения продолжаем сохранённую обычную партию.
                sfx.button_click()
                tutorial_state.is_tutorial = false
                tutorial_state.reset()
                gui.set_enabled(victory_overlay, false)
                gui.set_enabled(gui.get_node("tutorial_overlay"), false)
                gui.set_enabled(gui.get_node("hud_rail"), true)
                gui.set_enabled(gui.get_node("restart_button"), true)
                gui.set_enabled(gui.get_node("tutorial_button"), true)
                restart_level(true)
            elseif gui.pick_node(restart, action.x, action.y) then
                sfx.button_click()
                gui.set_enabled(victory_overlay, false)
                gui.set_enabled(gui.get_node("hud_rail"), true)
                gui.set_enabled(gui.get_node("restart_button"), true)
                gui.set_enabled(gui.get_node("tutorial_button"), true)
                restart_level()
            elseif gui.pick_node(menu, action.x, action.y) then
                sfx.button_click()
                tutorial_state.is_tutorial = false
                tutorial_state.reset()
                gui.set_enabled(victory_overlay, false)
                gui.set_enabled(gui.get_node("tutorial_overlay"), false)
                gui.set_enabled(gui.get_node("start_screen"), true)
                gui.set_enabled(gui.get_node("hud_rail"), false)
                gui.set_enabled(gui.get_node("restart_button"), false)
                gui.set_enabled(gui.get_node("tutorial_button"), false)
                self.game_started = false
                msg.post("/main#game_manager", "unload_level")
            end

            return true
        end

        -- Игровые кнопки.
        -- gui.pick_node — чисто геометрическая проверка: она попадает и по
        -- ВЫКЛЮЧЕННОЙ ноде. Во время туториала кнопки выключены, но управление
        -- доходит сюда, и тап по рельсу перезапустил бы партию. Поэтому
        -- обязателен gui.is_enabled перед pick_node.
        -- return true стоит ВНУТРИ ветки: только реальное попадание по кнопке
        -- съедает ввод. Безусловный return true в конце убил бы драг карт.
        local restart_button = gui.get_node("restart_button")
        if gui.is_enabled(restart_button) and gui.pick_node(restart_button, action.x, action.y) then
            sfx.button_click()
            restart_level()
            return true
        end

        local tutorial_button = gui.get_node("tutorial_button")
        if gui.is_enabled(tutorial_button) and gui.pick_node(tutorial_button, action.x, action.y) then
            sfx.button_click()
            tutorial_state.is_tutorial = true
            tutorial_state.reset()
            gui.set_enabled(gui.get_node("tutorial_overlay"), true)
            gui.set_enabled(gui.get_node("hud_rail"), false)
            gui.set_enabled(tutorial_button, false)
            gui.set_enabled(restart_button, false)
            update_tutorial_hint()
            restart_level(true)
            return true
        end
    end
end

function update(self, dt)
    celebration.update(self, dt)
    -- Poll shared state (cross-collection workaround: msg.post can't reach UI from proxied collection)
    if tutorial_state.ui_dirty then
        tutorial_state.ui_dirty = false
        update_tutorial_hint()
    end
    if tutorial_state.show_victory then
        tutorial_state.show_victory = false
        -- D1: партия окончена — для платформы геймплей кончился здесь, а не
        -- когда игрок уйдёт в меню. Уровень под оверлеем ещё загружен.
        msg.post("/main#game_manager", "gameplay_over")
        local overlay = gui.get_node("victory_overlay")
        -- Animate the panel and its title together; each theme owns its palette.
        local title = gui.get_node("victory_title_plate")
        local btn_play = gui.get_node("victory_restart")
        local btn_menu = gui.get_node("victory_menu_button")

        -- Скрыть tutorial overlay при победе
        gui.set_enabled(gui.get_node("tutorial_overlay"), false)

        -- G6: рельс и его кнопки прячем вместе. Раньше кнопки были мелкими и в
        -- углу, поэтому их забыли гасить на победе; теперь без рельса они висели
        -- бы над экраном победы сами по себе. Обратно их включают ветки
        -- victory_restart в on_input.
        gui.set_enabled(gui.get_node("hud_rail"), false)
        gui.set_enabled(gui.get_node("restart_button"), false)
        gui.set_enabled(gui.get_node("tutorial_button"), false)

        apply_victory_texts()

        gui.set_enabled(overlay, true)
        celebration.start(self)

        -- Solid full-screen background also covers the letterboxed area.
        gui.set_color(overlay, theme_color("background", 0))
        gui.animate(overlay, "color.w", 1.0, gui.EASING_OUTQUAD, 0.5)

        -- Title: slide down + scale bounce
        gui.set_position(title, vmath.vector3(0, 160, 0))
        gui.set_scale(title, vmath.vector3(0.5, 0.5, 1))
        gui.set_color(title, theme_color("panel", 0))
        gui.animate(title, "position.y", 60, gui.EASING_OUTBACK, 0.5, 0.3)
        gui.animate(title, "scale", vmath.vector3(1, 1, 1), gui.EASING_OUTBACK, 0.4, 0.3)
        gui.animate(title, "color.w", 1.0, gui.EASING_OUTQUAD, 0.3, 0.3)

        -- Buttons: fade in with slide up
        gui.set_color(btn_play, theme_color("primary", 0))
        gui.set_position(btn_play, vmath.vector3(0, -70, 0))
        gui.animate(btn_play, "color.w", 1.0, gui.EASING_OUTQUAD, 0.3, 0.6)
        gui.animate(btn_play, "position.y", -40, gui.EASING_OUTQUAD, 0.3, 0.6)

        gui.set_color(btn_menu, theme_color("secondary", 0))
        gui.set_position(btn_menu, vmath.vector3(0, -150, 0))
        gui.animate(btn_menu, "color.w", 1.0, gui.EASING_OUTQUAD, 0.3, 0.75)
        gui.animate(btn_menu, "position.y", -120, gui.EASING_OUTQUAD, 0.3, 0.75)
    end
end

function final(self)
    celebration.clear(self)
end

function on_message(self, message_id, message)
    -- D1: SDK ответил язык игрока уже после init — подписи перекрашиваем.
    -- apply_language идемпотентна: пишет тексты по тем же ключам заново.
    if message_id == hash("language_ready") then
        apply_language()
    end
end
